{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsi.nonoun.io/schema/terms-file.schema.json",
  "title": "Term mappings",
  "description": "How one product's naming vocabulary maps to facet values: mappings/<product>/terms.json. Used by @dsi/classify to decompose token names. Terms are judgments like token mappings: proposed, approved, rejected.",
  "type": "object",
  "required": ["product", "terms"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "product": { "$ref": "common.schema.json#/$defs/slug" },
    "noise": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Words that carry no meaning in this product's names (md, sys, color)." },
    "scopes": {
      "type": "array",
      "description": "First matching rule sets a token's scope.",
      "items": {
        "type": "object",
        "required": ["scope"],
        "additionalProperties": false,
        "properties": {
          "pathPrefix": { "type": "string" },
          "file": { "type": "string", "description": "Suffix of the token's source file." },
          "scope": { "enum": ["palette", "foundation", "semantic", "component", "other"] }
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "facet", "value", "match", "status", "provenance"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "One or more name words joined by '-', matched longest first." },
          "facet": { "enum": ["intent", "usage", "property", "emphasis", "state"] },
          "value": { "$ref": "common.schema.json#/$defs/slug" },
          "match": { "enum": ["exact", "close", "broad", "narrow", "related"] },
          "status": { "$ref": "common.schema.json#/$defs/slug" },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "support": { "type": "integer", "minimum": 0 }, "agree": { "type": "integer", "minimum": 0 }, "precision": { "type": "number", "minimum": 0, "maximum": 1 } },
            "description": "From approved token mappings: tokens containing the term, how many of them bind this value, and the ratio."
          },
          "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
          "review": { "type": "object", "required": ["by", "at"], "additionalProperties": false, "properties": { "by": { "type": "string" }, "at": { "type": "string", "format": "date-time" }, "note": { "type": "string" } } },
          "note": { "type": "string" }
        },
        "if": { "properties": { "status": { "enum": ["approved", "rejected"] } } },
        "then": { "required": ["review"] }
      }
    }
  }
}
