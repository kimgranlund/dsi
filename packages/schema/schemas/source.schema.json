{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsi.nonoun.io/schema/source.schema.json",
  "title": "Ingestion source",
  "description": "How to ingest one product's shipped tokens. File: sources/<product>/source.json.",
  "type": "object",
  "required": [
    "product",
    "package",
    "entries",
    "adapter",
    "license"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "product": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Catalog id of the product."
    },
    "implementation": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "Implementation id, required when the product is a Design System."
    },
    "package": {
      "type": "object",
      "required": [
        "registry",
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "const": "npm"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "common.schema.json#/$defs/exactVersion"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Path inside the package."
          },
          "format": {
            "enum": [
              "dtcg",
              "dtcg-resolver",
              "json",
              "js-module",
              "css",
              "scss",
              "ts-token-groups",
              "sass-doc-groups",
              "sass-module",
              "sass-vars",
              "atlassian-palette",
              "atlassian-tokens",
              "atlassian-names",
              "primer-palette",
              "primer-theme",
              "primer-docs",
              "spectrum"
            ]
          },
          "theme": {
            "type": "string",
            "description": "Native theme this entry holds, if theme-specific."
          },
          "package": {
            "type": "string",
            "description": "Package the path is in, when not the main package."
          },
          "nativeName": {
            "type": "string",
            "pattern": "\\{path\\}",
            "description": "How the product names these tokens in its public API, with {path} for the token's path, e.g. --cds-{path}. Omit when the DTCG path is the shipped name."
          },
          "groupOrder": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Group order when the shipped groups come in no meaningful order (e.g. alphabetical files), taken from the product's docs."
          },
          "groupOrderSource": {
            "type": "string",
            "format": "uri",
            "description": "Where groupOrder comes from."
          },
          "group": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "sass-module: token path prefix and output file group."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "sass-module: the public variables to read (all when omitted)."
          },
          "flatten": {
            "type": "boolean",
            "description": "sass-module: drop the variable name from token paths (one map per group)."
          },
          "skipKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "sass-module: map keys not ingested, with a manifest note (e.g. per-breakpoint overrides)."
          },
          "modules": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "sass-vars: module names in the directory at path, in dependency order."
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "sass-module: public variables not ingested, e.g. a map that only indexes the others."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "format": {
                  "const": "sass-module"
                }
              }
            },
            "then": {
              "required": [
                "package",
                "group"
              ]
            }
          }
        ]
      }
    },
    "themes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "Native theme names (e.g. white, g10, g90, g100). Their canonical modes are mapping judgments."
    },
    "adapter": {
      "$ref": "common.schema.json#/$defs/slug",
      "description": "packages/ingest/src/adapters/<adapter>.ts"
    },
    "license": {
      "type": "object",
      "required": [
        "spdx",
        "redistribution"
      ],
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "$ref": "common.schema.json#/$defs/spdx",
          "description": "SPDX expression, or LicenseRef-<name> for a non-standard license."
        },
        "url": {
          "$ref": "common.schema.json#/$defs/uri"
        },
        "redistribution": {
          "enum": [
            "permitted",
            "unknown",
            "restricted"
          ],
          "description": "Whether token values may be republished on the site. Unknown blocks publishing."
        },
        "notes": {
          "type": "string"
        },
        "publishOverride": {
          "type": "object",
          "description": "Owner decision to publish values despite redistribution being restricted or unknown. Records who accepted the risk, not that the license permits it.",
          "required": [
            "by",
            "at",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string",
              "format": "date"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Further packages the adapter reads, each pinned exactly (e.g. @carbon/colors for the palette @carbon/themes references).",
      "items": {
        "type": "object",
        "required": [
          "registry",
          "name",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "registry": {
            "const": "npm"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "$ref": "common.schema.json#/$defs/exactVersion"
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "description": "Which native theme represents each canonical mode (keys: slugs of dsi:scheme/mode; values: names from themes). Chosen from the product's own shipped metadata (e.g. Carbon's color-scheme extension); the canonical resolver answers a mode with this theme.",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "modesNote": {
      "type": "string",
      "description": "Evidence for the modes choice."
    },
    "themeExtends": {
      "type": "object",
      "description": "A theme that only overrides another theme: lookups fall back to that theme, then to the base files (Material expressive extends light).",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
