{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsi.nonoun.io/schema/catalog-entry.schema.json",
  "title": "Catalog entry",
  "description": "One product in any category. File: catalog/<category>/<id>.json.",
  "type": "object",
  "required": ["id", "name", "category", "description"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "$ref": "common.schema.json#/$defs/conceptRef", "description": "A concept in dsi:scheme/categories." },
    "organization": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "homepage": { "$ref": "common.schema.json#/$defs/uri" },
    "repository": { "$ref": "common.schema.json#/$defs/uri" },
    "license": { "$ref": "common.schema.json#/$defs/spdx" },
    "targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/conceptRef" } },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Catalog relations from ontology/vocab.jsonld. Values are catalog ids (product or implementation).",
      "properties": {
        "implements": { "$ref": "#/$defs/ids" },
        "builtOn": { "$ref": "#/$defs/ids" },
        "consumesTokensFrom": { "$ref": "#/$defs/ids" },
        "usesFormat": { "$ref": "#/$defs/ids" },
        "providesTokenSet": { "$ref": "#/$defs/ids" }
      }
    },
    "implementations": {
      "type": "array",
      "description": "Design Systems only: shipped codebases of this design system.",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/slug" },
          "name": { "type": "string", "minLength": 1 },
          "package": { "type": "string" },
          "repository": { "$ref": "common.schema.json#/$defs/uri" },
          "license": { "$ref": "common.schema.json#/$defs/spdx" },
          "targets": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/conceptRef" } }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/slug" } }
  }
}
