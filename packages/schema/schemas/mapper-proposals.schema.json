{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsi.nonoun.io/schema/mapper-proposals.schema.json",
  "title": "Mapper proposals",
  "description": "What one mapping agent returns for one packet. Written to .cache/mapper/<run>/<product>.<role>.proposals.json and merged by `dsi-map merge`.",
  "type": "object",
  "required": ["packet", "role", "model", "at", "proposals"],
  "additionalProperties": false,
  "properties": {
    "packet": { "type": "string", "description": "The packet id this answers." },
    "role": { "enum": ["a", "b"] },
    "model": { "type": "string", "minLength": 1, "description": "Model ID of the agent that wrote this file." },
    "at": { "type": "string", "format": "date-time" },
    "proposals": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["token", "concept", "match", "confidence", "rationale"],
            "additionalProperties": false,
            "properties": {
              "token": { "type": "string", "minLength": 1 },
              "concept": { "$ref": "common.schema.json#/$defs/conceptRef" },
              "match": { "enum": ["exact", "close", "broad", "narrow", "related"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "required": ["token", "unmapped", "rationale"],
            "additionalProperties": false,
            "properties": {
              "token": { "type": "string", "minLength": 1 },
              "unmapped": { "const": true },
              "rationale": { "type": "string", "minLength": 1, "description": "Which concept is missing from the ontology." }
            }
          }
        ]
      }
    }
  }
}
