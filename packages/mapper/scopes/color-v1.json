{
  "$comment": "Which native tokens the color-v1 mapping run covers: semantic and system color tokens. Palettes (Source tier) and component tokens are out of scope until hue and component vocabularies exist.",
  "id": "color-v1",
  "domain": "color",
  "prompt": "packages/mapper/prompts/color-v1.md",
  "products": {
    "material": {
      "version": "2.5.0",
      "pathPrefix": [
        "md.sys.color."
      ]
    },
    "carbon": {
      "version": "11.84.0",
      "provenanceFile": [
        "theme.tokens.json"
      ]
    },
    "polaris": {
      "version": "9.4.2",
      "pathPrefix": [
        "color-"
      ],
      "exclude": [
        "color-scheme"
      ]
    },
    "atlassian": {
      "version": "20.6.1",
      "pathPrefix": [
        "color.",
        "elevation.surface."
      ],
      "exclude": [
        "color.palette."
      ]
    },
    "primer": {
      "version": "11.10.0",
      "pathPrefix": [
        "fgColor.",
        "bgColor.",
        "borderColor.",
        "focus.",
        "selection.",
        "highlight.",
        "page.",
        "overlay.",
        "ansi.",
        "display.",
        "data.",
        "prettylights.",
        "codeMirror.",
        "diffBlob.",
        "contribution.",
        "shadow."
      ]
    },
    "spectrum": {
      "version": "15.6.0",
      "provenanceFile": [
        "src/semantic-color-palette.json",
        "src/color-aliases.json"
      ]
    },
    "fluent": {
      "version": "1.0.0-alpha.24",
      "pathPrefix": [
        "color"
      ]
    }
  }
}
