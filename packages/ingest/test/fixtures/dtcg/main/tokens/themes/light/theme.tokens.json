{ "$extensions": { "com.example": { "color-scheme": "light" } },
  "support-error": { "$type": "color", "$value": "{red.60}", "$description": "Error color.", "$extensions": { "com.example": { "x": 1 } } },
  "error-fade": { "$type": "color", "$value": { "colorSpace": { "$ref": "#/red/60/$value/colorSpace" }, "components": { "$ref": "#/red/60/$value/components" }, "alpha": 0.5 } } }
