{
  "@context": "../context.jsonld",
  "@graph": [
    {
      "id": "dsi:scheme/facets",
      "type": "ConceptScheme",
      "prefLabel": "Facets",
      "definition": "The dimensions a canonical concept or native token can bind. A canonical concept is a combination of facet values, e.g. Danger = intent/danger; Danger background, strong, on hover = intent/danger + property/background + emphasis/strong + state/hover.",
      "scopeNote": "An unbound facet means the token is not specific to that dimension. For emphasis, the bare concept is the default step (ADR 0019). For other facets unbound is not a default value: a token with no state facet is not the same as one bound to a rest state."
    },

    {
      "id": "dsi:scheme/facet-kinds",
      "type": "ConceptScheme",
      "prefLabel": "Facet kinds"
    },
    {
      "id": "dsi:facet-kind/identity",
      "type": "Concept",
      "inScheme": "dsi:scheme/facet-kinds",
      "topConceptOf": "dsi:scheme/facet-kinds",
      "prefLabel": "Identity facet",
      "definition": "Part of what a token means. Two tokens that differ in an identity facet are different tokens and may map to different concepts."
    },
    {
      "id": "dsi:facet-kind/context",
      "type": "Concept",
      "inScheme": "dsi:scheme/facet-kinds",
      "topConceptOf": "dsi:scheme/facet-kinds",
      "prefLabel": "Context facet",
      "definition": "Selects which value a token resolves to without changing what it means. Scopes alias edges and values, never token identity or tier."
    },

    {
      "id": "dsi:facet/domain", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Domain", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/domain", "bindingProperty": "dsi:hasDomain",
      "definition": "The design concern a token belongs to.",
      "scopeNote": "Not the DTCG $type: a shadow token has $type shadow and domain elevation. DTCG owns value types."
    },
    {
      "id": "dsi:facet/scale", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Scale", "facetKind": "dsi:facet-kind/identity", "bindingProperty": "dsi:hasScale",
      "definition": "The named family of values a token is a step of: a hue (plum, red, neutral) or a dimension scale (space, radius).",
      "editorialNote": "No canonical value scheme yet. Scale names are product-specific; whether to canonicalize hues is deferred to the color concepts work."
    },
    {
      "id": "dsi:facet/step", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Step", "facetKind": "dsi:facet-kind/identity", "bindingProperty": "dsi:hasStep",
      "definition": "The absolute position of a token within one scale, as its product numbers it; comparable only within that scale.", "scopeNote": "Absolute position within a scale, as the product numbers it (12, 40, 600). A literal, not a concept; steps are only comparable within one scale of one product."
    },
    {
      "id": "dsi:facet/emphasis", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Emphasis", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/emphasis", "bindingProperty": "dsi:hasEmphasis",
      "definition": "Relative strength within a scale or intent (subtle, strong), as opposed to an absolute step."
    },
    {
      "id": "dsi:facet/intent", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Intent", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/intent", "bindingProperty": "dsi:hasIntent",
      "definition": "What the token communicates, independent of hue: status, brand emphasis or action consequence."
    },
    {
      "id": "dsi:facet/hue", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Hue", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/hue", "bindingProperty": "dsi:hasHue",
      "definition": "The named hue of a member of a categorical color set, where the hue itself carries the meaning.",
      "scopeNote": "Not for status or brand colors: Danger is an intent, whatever its hue. Binds only together with usage/categorical (ADR 0017) or usage/terminal (ADR 0023)."
    },
    {
      "id": "dsi:facet/syntax", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Syntax", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/syntax", "bindingProperty": "dsi:hasSyntax",
      "definition": "The code or document syntax role a token colors (keyword, string, comment...). Values are the @lezer/highlight tags (ontology/schemes/syntax.jsonld)."
    },
    {
      "id": "dsi:facet/brightness", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Brightness", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/brightness", "bindingProperty": "dsi:hasBrightness",
      "definition": "Lightness relative to its family that holds in every theme (dimmest stays dimmest in light and dark), independent of emphasis.",
      "example": "Material surface-dim, surface-bright (m3.material.io/styles/color/roles: keep their relative brightness across both light and dark theme)"
    },
    {
      "id": "dsi:facet/property", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Property", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/property", "bindingProperty": "dsi:hasProperty",
      "definition": "Which visual property the token is meant to paint or size (background, text, border, ...).",
      "scopeNote": "Does not define a tier: Polaris color-bg-fill-critical binds property and intent and is Semantic."
    },
    {
      "id": "dsi:facet/usage", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Usage", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/usage", "bindingProperty": "dsi:hasUsage",
      "definition": "Where in the interface the token applies across components (page, surface, overlay, field, link, ...).",
      "editorialNote": "v1 values derived from Material, Carbon and Polaris semantic color tokens. Surface depth levels (Carbon layer-01..03, Material surface-container-low..highest) are expressed with emphasis or close matches, not separate usages."
    },
    {
      "id": "dsi:facet/component", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Component", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/component", "bindingProperty": "dsi:hasComponent",
      "definition": "The component a token is scoped to (button, text field, ...).",
      "editorialNote": "Values are added when a product ships component-scoped tokens (ADR 0014); whose part names become canonical stays a PLAN.md open question."
    },
    {
      "id": "dsi:facet/part", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Part", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/part", "bindingProperty": "dsi:hasPart",
      "definition": "An anatomical part of a component (container, label, icon, track, thumb). Binds with a component, or with usage code-surface for code parts."
    },
    {
      "id": "dsi:facet/style", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Style", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/style", "bindingProperty": "dsi:hasStyle",
      "definition": "The motion or type character a token belongs to: quick and utilitarian, or larger and more noticeable.", "scopeNote": "Comparable across systems that split their motion or type into a productive and an expressive set (ADR 0014)."
    },
    {
      "id": "dsi:facet/state", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "State", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/state", "bindingProperty": "dsi:hasState",
      "definition": "The interaction or selection state the token applies to."
    },
    {
      "id": "dsi:facet/mode", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Mode", "facetKind": "dsi:facet-kind/context", "valueScheme": "dsi:scheme/mode", "bindingProperty": "dsi:inMode",
      "definition": "The theme context a value or alias edge holds in (light, dark, increased contrast).",
      "scopeNote": "Product themes map to canonical modes with typed matches: Carbon g10 and g100 are product themes, not modes."
    },

    { "id": "dsi:scheme/domain", "type": "ConceptScheme", "prefLabel": "Domain values" },
    { "id": "dsi:domain/color", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Color", "definition": "Token values that set the color of interface elements, including fills, text, icons, borders and shadow colors." },
    { "id": "dsi:domain/space", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Space", "nameForm": "spacing", "definition": "Gaps, padding and margins between elements." },
    { "id": "dsi:domain/size", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Size", "definition": "Dimensions of elements themselves (icon size, control height)." },
    { "id": "dsi:domain/shape", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Shape", "definition": "Corner radius and border width." },
    { "id": "dsi:domain/typography", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Typography", "definition": "Token values that set how text looks: font family, size, weight, line height, letter spacing and composed type styles.", "nameForm": "type style" },
    { "id": "dsi:domain/elevation", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Elevation", "nameForm": "shadow", "definition": "Shadows and depth layering." },
    { "id": "dsi:domain/motion", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Motion", "definition": "Durations and easing." },
    { "id": "dsi:domain/layout", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Layout", "nameForm": "layout value", "definition": "Page-level layout values: breakpoints, z-index layers, container widths." },
    { "id": "dsi:domain/opacity", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Opacity", "definition": "Token values that set how transparent an element or layer is, from fully transparent to fully opaque." },

    { "id": "dsi:scheme/brightness", "type": "ConceptScheme", "prefLabel": "Brightness values" },
    { "id": "dsi:brightness/dim", "type": "Concept", "inScheme": "dsi:scheme/brightness", "topConceptOf": "dsi:scheme/brightness", "prefLabel": "Dim", "definition": "The dimmest member of its family in every theme." },
    { "id": "dsi:brightness/bright", "type": "Concept", "inScheme": "dsi:scheme/brightness", "topConceptOf": "dsi:scheme/brightness", "prefLabel": "Bright", "definition": "The brightest member of its family in every theme." },

    { "id": "dsi:scheme/emphasis", "type": "ConceptScheme", "prefLabel": "Emphasis values", "editorialNote": "Seven steps since ADR 0018 (subtlest, subtler, subtle, default, strong, stronger, strongest). Steps are assigned by contrast rank against the page within a family, per mode; the native word maps exact only when its rank agrees, else close." },
    { "id": "dsi:emphasis/subtlest", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtlest", "altLabel": ["lowest"], "notation": "1", "definition": "The weakest step of an emphasis family that has more than three steps.", "scopeNote": "The weakest step of a family with more than three steps, e.g. Material surface-container-lowest. Other systems' words (altLabel, search only): lowest (Material)." },
    { "id": "dsi:emphasis/subtler", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtler", "notation": "2", "definition": "The step between subtlest and subtle in an emphasis family.", "scopeNote": "Between subtlest and subtle (Atlassian subtler)." },
    { "id": "dsi:emphasis/subtle", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtle", "altLabel": ["muted", "secondary", "variant", "low"], "scopeNote": "Other systems' words (altLabel, search only): muted (Primer); secondary (Carbon, Polaris); variant (Material); low (Material).", "definition": "A step weaker than the unmarked member of its family, contrasting less with the page.", "notation": "3" },
    { "id": "dsi:emphasis/default", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Default", "notation": "4", "definition": "Explicitly the middle emphasis, where the product names it (e.g. a 'base' or 'default' variant).", "deprecated": true, "editorialNote": "Deprecated 2026-11-01 (owner decision, ADR 0019 amendment): the concept without emphasis is the default step, so this value is never bound and the word 'default' in token names is noise." },
    { "id": "dsi:emphasis/strong", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Strong", "altLabel": ["bold", "high", "prominent"], "scopeNote": "Other systems' words (altLabel, search only): bold (Atlassian); high (Material); prominent (Material).", "definition": "A step stronger than the unmarked member of its family, contrasting more with the page.", "notation": "5" },
    { "id": "dsi:emphasis/stronger", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Stronger", "altLabel": ["bolder"], "notation": "6", "definition": "The step between strong and strongest in an emphasis family.", "scopeNote": "Between strong and strongest (Atlassian bolder). Other systems' words (altLabel, search only): bolder (Atlassian)." },
    { "id": "dsi:emphasis/strongest", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Strongest", "altLabel": ["boldest", "highest"], "notation": "7", "definition": "The strongest step of an emphasis family that has more than three steps.", "scopeNote": "The strongest step of a family with more than three steps, e.g. Material surface-container-highest. Other systems' words (altLabel, search only): boldest (Atlassian); highest (Material)." },

    { "id": "dsi:scheme/intent", "type": "ConceptScheme", "prefLabel": "Intent values", "scopeNote": "Native names (Critical, Error, Destructive) are not labels here. They belong in mappings with a match type, because they are rarely exact synonyms." },
    { "id": "dsi:intent/accent", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Accent", "altLabel": ["brand", "primary"], "scopeNote": "Other systems' words (altLabel, search only): brand (Carbon, Polaris, Atlassian, Fluent); primary (Material).", "definition": "Brand or primary color that draws attention without communicating status." },
    { "id": "dsi:intent/neutral", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Neutral", "definition": "Deliberately carries no status or brand meaning." },
    { "id": "dsi:intent/info", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Info", "altLabel": ["information", "informative"], "scopeNote": "Other systems' words (altLabel, search only): information (Carbon, Atlassian); informative (Spectrum).", "definition": "Status: informational, no action required.", "related": ["dsi:intent/discovery"] },
    { "id": "dsi:intent/discovery", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Discovery", "definition": "Marks something new or changed that invites exploration: new features, onboarding, promotion. Not a status and not a warning.", "example": "Atlassian color.background.discovery (\"change or something new\"); Primer upsell (close).", "related": ["dsi:intent/info", "dsi:intent/ai"] },
    { "id": "dsi:intent/success", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Success", "altLabel": ["positive"], "definition": "Status: completed or positive outcome.", "related": ["dsi:intent/done"], "scopeNote": "A positive outcome. Work that is finished or merged, whatever its outcome, is intent/done (ADR 0023). Other systems' words (altLabel, search only): positive (Spectrum, Fluent)." },
    { "id": "dsi:intent/warning", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Warning", "altLabel": ["attention", "notice"], "scopeNote": "Other systems' words (altLabel, search only): attention (Primer); notice (Spectrum).", "definition": "Status: needs attention; something may go wrong.", "related": ["dsi:intent/severe"] },
    {
      "id": "dsi:intent/danger", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Danger", "altLabel": ["error", "critical", "negative"],
      "definition": "Status: something is wrong, failed or at risk.",
      "related": ["dsi:intent/destructive", "dsi:intent/severe"],
      "scopeNote": "Explorer Danger views also list Destructive tokens, marked as related, not equal. Other systems' words (altLabel, search only): error (Material, Carbon); critical (Polaris); negative (Spectrum)."
    },
    {
      "id": "dsi:intent/caution", "type": "Concept", "inScheme": "dsi:scheme/intent", "prefLabel": "Caution",
      "broader": "dsi:intent/warning",
      "definition": "Status: a milder level of warning; worth noticing, unlikely to cause harm.",
      "example": "Polaris caution tokens (below its warning), Carbon support-caution-minor"
    },
    {
      "id": "dsi:intent/highlight", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Highlight",
      "definition": "Marks a region the user is focusing on, editing or has selected as text, without status or brand meaning.",
      "example": "Polaris emphasis tokens (editor focus areas), Carbon highlight (text selection)"
    },
    {
      "id": "dsi:intent/ai", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "AI", "altLabel": ["magic"], "scopeNote": "Other systems' words (altLabel, search only): magic (Polaris).", "nameForm": "AI",
      "definition": "Marks content or actions generated or assisted by AI.",
      "example": "Carbon ai-* tokens, Polaris magic tokens",
      "related": ["dsi:intent/discovery"]
    },
    {
      "id": "dsi:intent/destructive", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Destructive",
      "definition": "Action consequence: the action deletes data or cannot be undone. Describes an action, not a status.",
      "related": ["dsi:intent/danger"]
    },
    { "id": "dsi:intent/done", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Done", "definition": "Status of work that is finished or merged, whatever its outcome.", "example": "Primer fgColor.done, bgColor.done.emphasis", "related": ["dsi:intent/success"], "scopeNote": "ADR 0023." },
    { "id": "dsi:intent/severe", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Severe", "definition": "Status serious enough to need prompt attention: stronger than a warning, short of danger.", "example": "Primer bgColor.severe.emphasis, Carbon support-caution-major", "related": ["dsi:intent/warning", "dsi:intent/danger"], "scopeNote": "Usually orange, between yellow warning and red danger. ADR 0024." },

    { "id": "dsi:scheme/usage", "type": "ConceptScheme", "prefLabel": "Usage values" },
    { "id": "dsi:usage/page", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on the page", "prefLabel": "Page", "altLabel": ["base"], "scopeNote": "Other systems' words (altLabel, search only): base (Spectrum).", "definition": "The outermost application background behind all surfaces.", "example": "Carbon background, Polaris color-bg, Material background" },
    { "id": "dsi:usage/surface", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on surfaces", "prefLabel": "Surface", "altLabel": ["layer"], "scopeNote": "Other systems' words (altLabel, search only): layer (Carbon, Spectrum).", "definition": "Containers placed on the page: cards, panels, layers.", "example": "Polaris color-bg-surface, Carbon layer-01, Material surface-container" },
    { "id": "dsi:usage/overlay", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on overlays", "prefLabel": "Overlay", "altLabel": ["elevated"], "scopeNote": "Other systems' words (altLabel, search only): elevated (Spectrum).", "definition": "Content floating above the page: menus, popovers, modals." },
    { "id": "dsi:usage/scrim", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "for backdrops", "prefLabel": "Backdrop", "altLabel": ["scrim", "blanket"], "scopeNote": "The CSS name (::backdrop) for the dimming layer behind a modal. Other systems' words (altLabel, search only): scrim (Material); blanket (Atlassian); Polaris and Primer say backdrop.", "definition": "The dimming layer behind a modal overlay.", "example": "Material scrim, Carbon overlay" },
    { "id": "dsi:usage/inverse", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on inverse surfaces", "prefLabel": "Inverse", "altLabel": ["inverted"], "definition": "Contrasting surfaces with the opposite lightness of the current theme (e.g. dark tooltip in light mode).", "example": "Material inverse-surface, Carbon background-inverse, Polaris color-bg-inverse", "scopeNote": "Only when the surface flips relative to the page between modes (Primer bgColor.inverse, Fluent BackgroundInverted, Carbon background-inverse), or content placed on such a surface (ADR 0018). Other systems' words (altLabel, search only): inverted (Fluent)." },
    { "id": "dsi:usage/field", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in input fields", "prefLabel": "Field", "altLabel": ["control"], "scopeNote": "Other systems' words (altLabel, search only): control (Primer).", "definition": "Form inputs: text fields, selects, text areas.", "example": "Carbon field-01, Polaris color-input-bg-surface" },
    { "id": "dsi:usage/link", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "for links", "prefLabel": "Link", "definition": "Inline navigational text links.", "example": "Carbon link-primary, Polaris color-text-link" },
    { "id": "dsi:usage/categorical", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in a categorical set", "prefLabel": "Categorical", "definition": "A set of distinct colors assigned to identities or series, where each member is a different color, not a level.", "scopeNote": "A set of distinct colors assigned to identities or series (avatars by name hash, chart series), where each slot is a different color, not a level.", "example": "Polaris color-avatar-one..seven (assigned by hashing the user's name)" },
    { "id": "dsi:usage/data-viz", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in data visualization", "prefLabel": "Data visualization", "altLabel": ["chart"], "nameForm": "data-visualization", "definition": "Marks in charts and graphs, such as series colors and chart status colors.", "scopeNote": "Marks in charts and graphs: series colors, chart status colors. Combine with categorical (and hue) for series palettes; numbered slots without a hue name bind no hue. Other systems' words (altLabel, search only): chart (Atlassian).", "example": "Atlassian color.chart.*, Primer data.*" },
    { "id": "dsi:usage/code-surface", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on code surfaces", "prefLabel": "Code surface", "nameForm": "code-surface", "definition": "The surfaces of code blocks and editors: background, gutter, line numbers, highlighted lines and diff lines.", "example": "Atlassian color.background.code.*, Primer codeMirror.*, diffBlob.*", "scopeNote": "Not the deprecated usage/code, which syntax/* replaced. Syntax roles use syntax/*; diffs combine with syntax inserted, deleted or changed." },
    { "id": "dsi:usage/heading", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "for headings", "prefLabel": "Heading", "definition": "Text that titles content." },
    { "id": "dsi:usage/display", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "phrase": "for display text", "prefLabel": "Display", "definition": "The largest, most expressive headings." },
    { "id": "dsi:usage/headline", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "phrase": "for headlines", "prefLabel": "Headline", "definition": "High-emphasis headings for short, important text." },
    { "id": "dsi:usage/title", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "phrase": "for titles", "prefLabel": "Title", "definition": "Medium-emphasis headings for sections." },
    { "id": "dsi:usage/body", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "for body text", "prefLabel": "Body", "scopeNote": "A type role: the text style for running text. Not part/body, which is the main content region of a component.", "definition": "Running text." },
    { "id": "dsi:usage/label", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "for labels", "prefLabel": "Label", "scopeNote": "A type role: the text style for labels inside components. Not part/label, which is the region of a component that holds its main text.", "definition": "Text inside components (buttons, chips, tabs)." },
    { "id": "dsi:usage/state-layer", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in state layers", "prefLabel": "State layer", "nameForm": "state-layer", "definition": "A translucent layer that shows an interaction state (hover, pressed)." },
    { "id": "dsi:usage/navigation", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in navigation", "prefLabel": "Navigation", "definition": "Application navigation chrome: side nav, top bar.", "example": "Polaris color-nav-bg" },
    { "id": "dsi:usage/skeleton", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in loading skeletons", "prefLabel": "Skeleton", "altLabel": ["stencil", "skeleton loader"], "scopeNote": "Other systems' words (altLabel, search only): stencil (Fluent); skeleton loader (Atlassian).", "definition": "Loading placeholders.", "example": "Carbon skeleton-background" },
    { "id": "dsi:usage/code", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Code", "definition": "Code display and syntax highlighting.", "deprecated": true, "editorialNote": "Deprecated 2026-10-31 after color-v1 round 1: too coarse for syntax-highlighting roles, which stay unmapped until a syntax-role vocabulary exists." },
    { "id": "dsi:usage/on-fill", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "on a bold background", "prefLabel": "On fill", "altLabel": ["on color", "on emphasis", "on brand", "on primary"], "nameForm": "on-fill", "definition": "Content placed on a filled background, where it must contrast with that fill.", "example": "Material on-error, Polaris color-text-critical-on-bg-fill, Carbon text-on-color", "scopeNote": "Decide by value and description, not by the native word: content that must contrast with a bold fill is on-fill even when a system calls it inverse (Atlassian color.text.inverse). Content on a subtle or light container is not on-fill (boundary B4, ADR 0021). Usage inverse is only for surfaces that flip between modes, or content on them (ADR 0018). Other systems' words (altLabel, search only): on color (Carbon); on emphasis (Primer); on brand (Fluent); on primary (Material)." },
    { "id": "dsi:usage/fixed", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "that stays fixed across themes", "prefLabel": "Fixed", "definition": "Color that keeps one value in every theme, for content that sits on media or brand imagery.", "example": "Spectrum static-white-*, Material md.sys.color.*-fixed, Primer bgColor.black", "scopeNote": "Combine with brightness for black (dim) and white (bright) variants. ADR 0023." },
    { "id": "dsi:usage/transparent", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "as a transparent slot", "prefLabel": "Transparent", "definition": "Deliberately unpainted slot, fully transparent in standard themes, kept so paint can appear in other states or high contrast.", "example": "Fluent colorTransparentBackground, Primer bgColor.transparent, Polaris color-bg-surface-transparent", "scopeNote": "ADR 0023." },
    { "id": "dsi:usage/terminal", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "phrase": "in the terminal palette", "prefLabel": "Terminal", "definition": "Color in the sixteen-slot ANSI palette that command-line output uses.", "example": "Primer ansi.red, ansi.redBright", "scopeNote": "Binds a hue; the bright slots bind brightness bright. ADR 0023." },

    { "id": "dsi:scheme/property", "type": "ConceptScheme", "prefLabel": "Property values" },
    { "id": "dsi:property/background", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "backgrounds", "prefLabel": "Background", "definition": "Fill behind content: surfaces, containers, fills." },
    { "id": "dsi:property/foreground", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "text and icons", "prefLabel": "Foreground", "altLabel": ["content"], "scopeNote": "Other systems' words (altLabel, search only): content (Material, Spectrum).", "definition": "Text and icons together: one token colors both.", "example": "Material on-surface, Carbon text-on-color" },
    { "id": "dsi:property/text", "type": "Concept", "inScheme": "dsi:scheme/property", "broader": "dsi:property/foreground", "topConceptOf": "dsi:scheme/property", "phrase": "text", "prefLabel": "Text", "definition": "Text color only. A token that colors both text and icons binds foreground instead." },
    { "id": "dsi:property/icon", "type": "Concept", "inScheme": "dsi:scheme/property", "broader": "dsi:property/foreground", "topConceptOf": "dsi:scheme/property", "phrase": "icons", "prefLabel": "Icon", "definition": "The color or size of icons and other small symbolic graphics." },
    { "id": "dsi:property/graphic", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "graphics", "prefLabel": "Graphic", "altLabel": ["visual", "graphical element"], "definition": "The color of non-text marks: icons, status dots, illustrations, and meter or chart fills.", "scopeNote": "For tokens that paint graphics generally, such as Spectrum *-visual-color (ADR 0022). A token only for icons binds icon. Other systems' words (altLabel, search only): visual (Spectrum); graphical element (Carbon)." },
    { "id": "dsi:property/border", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "borders", "prefLabel": "Border", "altLabel": ["outline", "stroke"], "scopeNote": "Other systems' words (altLabel, search only): outline (Material); stroke (Fluent).", "definition": "Borders, dividers and outlines that are part of layout." },
    { "id": "dsi:property/focus-ring", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "focus rings", "prefLabel": "Focus ring", "altLabel": ["focus indicator", "focus border", "focus outline"], "scopeNote": "Other systems' words (altLabel, search only): focus indicator (Atlassian); focus border (Carbon); focus outline (Primer).", "definition": "The outline drawn around an element that has keyboard focus." },
    { "id": "dsi:property/shadow", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "phrase": "shadows", "prefLabel": "Shadow", "definition": "The shadow cast by an element to show its elevation above the surface behind it.", "dsi:inDomain": { "id": "dsi:domain/elevation" } },

    { "id": "dsi:property/spacing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Margins and gutters", "scopeNote": "The broader design concept. CSS implements it as margin, padding, gap and sometimes inset; bind the narrower value when the token's name or its use in component CSS says which, otherwise this one (owner decision, 2026-11-01).", "altLabel": ["spacing", "negative space", "whitespace"], "nameForm": "spacing", "definition": "Negative space between and inside elements, as in grids, gutters and gaps.", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/padding", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Padding", "definition": "Space inside a component between its edge and its content.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/gap", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Gap", "definition": "Space between a component's children.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/margin", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Margin", "definition": "Space outside a component or part, between it and its neighbours.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/inset", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Inset", "definition": "Offset of a positioned element from the edges of its container.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" }, "scopeNote": "CSS inset, top, right, bottom and left on positioned elements (owner decision, 2026-11-01)." },
    { "id": "dsi:property/corner-radius", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Corner radius", "definition": "Rounding of corners.", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/corner-shape", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Corner shape", "definition": "A set of four corner radii that rounds only some corners of an element.", "scopeNote": "A set of four corner radii, rounding only some corners (Material corner-large-top: 16px 16px 0 0).", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/border-width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Border width", "definition": "Thickness of borders and dividers.", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/height", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Height", "definition": "Fixed heights of elements (controls, rows).", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Width", "definition": "Fixed widths of elements.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Size", "definition": "Square dimensions used for both width and height.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/icon-size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Icon size", "definition": "Dimensions of icons.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/container-width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Container width", "definition": "Maximum widths of layout containers.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/breakpoint", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Breakpoint", "definition": "Viewport widths at which layouts change.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/z-index", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Z-index", "definition": "Stacking order of layers.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/elevation-level", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Elevation level", "definition": "Ordinal depth of a surface (level 0..5).", "dsi:inDomain": { "id": "dsi:domain/elevation" } },
    { "id": "dsi:property/opacity", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Opacity", "definition": "Transparency, such as state-layer overlays.", "dsi:inDomain": { "id": "dsi:domain/opacity" } },
    { "id": "dsi:property/font-family", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font family", "definition": "Typeface stack.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/font-weight", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font weight", "definition": "Weight of a typeface.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/font-size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font size", "definition": "Size of text.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/line-height", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Line height", "definition": "Height of a line of text.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/letter-spacing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Letter spacing", "definition": "Tracking between characters.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/duration", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Duration", "definition": "Length of an animation.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/easing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Easing", "definition": "Timing curve of an animation.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/spring-stiffness", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Spring stiffness", "definition": "Stiffness of a physics spring used instead of a duration and easing curve.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/spring-damping", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Spring damping", "definition": "Damping ratio of a physics spring (1 = no overshoot).", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/transition", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Transition", "definition": "A composite of duration, delay and easing.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/keyframes", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Keyframes", "definition": "A named animation sequence.", "dsi:inDomain": { "id": "dsi:domain/motion" } },

    { "id": "dsi:scheme/hue", "type": "ConceptScheme", "prefLabel": "Hue values", "scopeNote": "A small canonical set for categorical colors. Native hue names outside it (coral, plum, pine, olive, lemon, auburn, cool-gray) map close to the nearest value by hue angle; neutrals map to gray." },
    { "id": "dsi:hue/red", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Red", "definition": "Hue around 0°." },
    { "id": "dsi:hue/orange", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Orange", "definition": "Hue around 30°." },
    { "id": "dsi:hue/yellow", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Yellow", "definition": "Hue around 55°." },
    { "id": "dsi:hue/lime", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Lime", "definition": "Hue around 80°." },
    { "id": "dsi:hue/green", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Green", "definition": "Hue around 120°." },
    { "id": "dsi:hue/teal", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Teal", "definition": "Hue around 170°." },
    { "id": "dsi:hue/cyan", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Cyan", "definition": "Hue around 190°." },
    { "id": "dsi:hue/blue", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Blue", "definition": "Hue around 215°." },
    { "id": "dsi:hue/indigo", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Indigo", "definition": "Hue around 240°." },
    { "id": "dsi:hue/purple", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Purple", "definition": "Hue around 270°." },
    { "id": "dsi:hue/magenta", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Magenta", "definition": "Hue around 300°." },
    { "id": "dsi:hue/pink", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Pink", "definition": "Hue around 330°." },
    { "id": "dsi:hue/brown", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Brown", "definition": "Low-saturation warm hue around 25°, darker than orange." },
    { "id": "dsi:hue/gray", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Gray", "definition": "No dominant hue (includes cool and warm grays)." },

    { "id": "dsi:scheme/style", "type": "ConceptScheme", "prefLabel": "Style values", "scopeNote": "Carbon names its two motion and type styles productive and expressive; Material names its easing sets standard and emphasized. Both splits mean quick and utilitarian versus noticeable, so native names map here with close." },
    { "id": "dsi:style/productive", "type": "Concept", "inScheme": "dsi:scheme/style", "topConceptOf": "dsi:scheme/style", "prefLabel": "Productive", "altLabel": "Standard", "definition": "Quick, understated motion or compact type for everyday task work.", "editorialNote": "Source: https://carbondesignsystem.com/elements/motion/overview/" },
    { "id": "dsi:style/expressive", "type": "Concept", "inScheme": "dsi:scheme/style", "topConceptOf": "dsi:scheme/style", "prefLabel": "Expressive", "altLabel": "Emphasized", "definition": "Slower, more noticeable motion or display type for significant moments.", "editorialNote": "Source: https://m3.material.io/styles/motion/easing-and-duration" },

    { "id": "dsi:scheme/component", "type": "ConceptScheme", "prefLabel": "Component values", "scopeNote": "Only components that a product's shipped tokens name; not a component catalog." },
    { "id": "dsi:component/button", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Button", "definition": "A control that starts an action when the user activates it." },
    { "id": "dsi:component/button-group", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Button group", "definition": "A set of related buttons laid out together as one control." },
    { "id": "dsi:component/card", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Card", "definition": "A container that groups content and actions about one subject on its own surface." },
    { "id": "dsi:component/text-field", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Text field", "definition": "A single-line text input with its label and supporting text.", "scopeNote": "A single-line text input with its label and supporting text (Material text field, Carbon TextInput, Polaris TextField)." },
    { "id": "dsi:component/table", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Table", "definition": "A grid of rows and columns that presents structured data." },
    { "id": "dsi:component/slider", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Slider", "definition": "A control that selects a value by moving a thumb along a track.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/progress-bar", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Progress bar", "definition": "A bar that shows how much of a task or measure is complete.", "nameForm": "progress-bar", "scopeNote": "Also meters. ADR 0023." },
    { "id": "dsi:component/toggle", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Toggle", "definition": "A switch control that turns one setting on or off.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/scrollbar", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Scrollbar", "definition": "The control that shows and moves the scroll position of a scrolling region.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/chat", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Chat", "definition": "A conversation interface of messages exchanged between people, agents or bots.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/checkbox", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Checkbox", "definition": "A control that turns one option on or off within a set of independent options.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/radio", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Radio", "definition": "A control that selects exactly one option from a set.", "scopeNote": "ADR 0023." },
    { "id": "dsi:component/tooltip", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Tooltip", "definition": "A small overlay that labels or explains the element under the pointer or focus.", "scopeNote": "ADR 0023." },

    { "id": "dsi:scheme/part", "type": "ConceptScheme", "prefLabel": "Part values", "scopeNote": "Anatomical parts named by shipped component tokens. A part binds only together with a component." },
    { "id": "dsi:part/container", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Container", "definition": "The component's outer box: background, shape, border, elevation, padding." },
    { "id": "dsi:part/label", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Label", "scopeNote": "A region of a component that holds its main text. Not usage/label, which is a type role.", "definition": "The component's main text (button label, field label)." },
    { "id": "dsi:part/supporting-text", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Supporting text", "definition": "Helper or description text under the main text." },
    { "id": "dsi:part/input", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Input", "definition": "The editable text area of a field." },
    { "id": "dsi:part/icon", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Icon", "definition": "An icon inside the component." },
    { "id": "dsi:part/indicator", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Indicator", "definition": "A line or mark that shows the state of its component.", "scopeNote": "A line or mark that shows state (Material text field active indicator)." },
    { "id": "dsi:part/header", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Header", "definition": "A header region (card title area, table header row)." },
    { "id": "dsi:part/body", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Body", "scopeNote": "A region of a component. Not usage/body, which is a type role.", "definition": "The main content region." },
    { "id": "dsi:part/footer", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Footer", "definition": "A footer region with actions." },
    { "id": "dsi:part/row", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Row", "definition": "A table row." },
    { "id": "dsi:part/cell", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Cell", "definition": "One intersection of a row and a column in a table." },
    { "id": "dsi:part/gutter", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Gutter", "definition": "The margin column of a code editor or diff, beside the lines." },
    { "id": "dsi:part/line-number", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Line number", "definition": "The number shown for a line of code." },
    { "id": "dsi:part/line", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Line", "definition": "A whole line of code or diff, as opposed to a word within it." },
    { "id": "dsi:part/track", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Track", "definition": "The channel a slider thumb, progress fill or toggle knob moves along.", "scopeNote": "ADR 0023." },
    { "id": "dsi:part/thumb", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Thumb", "definition": "The movable handle of a slider, toggle or scrollbar.", "scopeNote": "ADR 0023." },
    { "id": "dsi:part/bubble", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Bubble", "definition": "The container of one message in a chat.", "scopeNote": "ADR 0023." },
    { "id": "dsi:part/prompt", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Prompt", "definition": "The input area where a chat message is written.", "scopeNote": "ADR 0023." },
    { "id": "dsi:part/avatar", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Avatar", "definition": "The image or initials that stand for a participant.", "scopeNote": "ADR 0023." },
    { "id": "dsi:part/tail", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Tail", "definition": "The pointer of an overlay that points at its anchor element.", "scopeNote": "ADR 0023." },

    { "id": "dsi:scheme/state", "type": "ConceptScheme", "prefLabel": "State values" },
    { "id": "dsi:state/hover", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Hover", "altLabel": ["hovered"], "scopeNote": "Other systems' words (altLabel, search only): hovered (Atlassian).", "definition": "The state of an element while a pointer rests over it.", "nameForm": "hovered" },
    { "id": "dsi:state/active", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Active", "altLabel": ["pressed", "down"], "nameForm": "pressed", "definition": "The state of an element while it is being pressed.", "scopeNote": "Being pressed. Material calls this pressed. Other systems' words (altLabel, search only): pressed (Material, Atlassian, Fluent); down (Spectrum)." },
    { "id": "dsi:state/focus", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Focus", "altLabel": ["focused", "keyboard focus"], "scopeNote": "Other systems' words (altLabel, search only): focused (Material, Atlassian); keyboard focus (Spectrum).", "definition": "The state of an element while keyboard or programmatic focus is on it.", "nameForm": "focused" },
    { "id": "dsi:state/disabled", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Disabled", "definition": "The state of an element that is shown but cannot be used." },
    { "id": "dsi:state/selected", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Selected", "definition": "The state of an element that the user has chosen from a set." },
    { "id": "dsi:state/dragged", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Dragged", "definition": "The state of an element while the user drags it.", "scopeNote": "Being dragged. Material state layers have a dragged opacity (0.16)." },
    { "id": "dsi:state/visited", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Visited", "definition": "A link the user has already followed." },

    { "id": "dsi:scheme/mode", "type": "ConceptScheme", "prefLabel": "Mode values" },
    { "id": "dsi:mode/light", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Light", "definition": "The theme with light surfaces and dark content." },
    { "id": "dsi:mode/dark", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Dark", "definition": "The theme with dark surfaces and light content." },
    { "id": "dsi:mode/expressive", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Expressive set", "definition": "A theme variant with stronger color, shape and motion for more noticeable interfaces.", "scopeNote": "A product's newer, more expressive token set shipped beside the one its components consume (Material Web tokens/versions/latest: M3 Expressive). Combines with light: color comes from light." },
    { "id": "dsi:mode/increased-contrast", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Increased contrast", "definition": "A theme variant that raises contrast between content and surfaces for users who need it.", "scopeNote": "Combines with light or dark; a product's high-contrast-dark theme binds both." }
  ]
}
