{
  "@context": "../context.jsonld",
  "@graph": [
    {
      "id": "dsi:scheme/facets",
      "type": "ConceptScheme",
      "prefLabel": "Facets",
      "definition": "The dimensions a canonical concept or native token can bind. A canonical concept is a combination of facet values, e.g. Danger = intent/danger; Danger background, strong, on hover = intent/danger + property/background + emphasis/strong + state/hover.",
      "scopeNote": "An unbound facet means the token is not specific to that dimension. It does not mean the default value: a token with no state facet is not the same as one bound to a rest state."
    },

    {
      "id": "dsi:scheme/facet-kinds",
      "type": "ConceptScheme",
      "prefLabel": "Facet kinds"
    },
    {
      "id": "dsi:facet-kind/identity",
      "type": "Concept",
      "inScheme": "dsi:scheme/facet-kinds",
      "topConceptOf": "dsi:scheme/facet-kinds",
      "prefLabel": "Identity facet",
      "definition": "Part of what a token means. Two tokens that differ in an identity facet are different tokens and may map to different concepts."
    },
    {
      "id": "dsi:facet-kind/context",
      "type": "Concept",
      "inScheme": "dsi:scheme/facet-kinds",
      "topConceptOf": "dsi:scheme/facet-kinds",
      "prefLabel": "Context facet",
      "definition": "Selects which value a token resolves to without changing what it means. Scopes alias edges and values, never token identity or tier."
    },

    {
      "id": "dsi:facet/domain", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Domain", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/domain", "bindingProperty": "dsi:hasDomain",
      "definition": "The design concern a token belongs to.",
      "scopeNote": "Not the DTCG $type: a shadow token has $type shadow and domain elevation. DTCG owns value types."
    },
    {
      "id": "dsi:facet/scale", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Scale", "facetKind": "dsi:facet-kind/identity", "bindingProperty": "dsi:hasScale",
      "definition": "The named family of values a token is a step of: a hue (plum, red, neutral) or a dimension scale (space, radius).",
      "editorialNote": "No canonical value scheme yet. Scale names are product-specific; whether to canonicalize hues is deferred to the color concepts work."
    },
    {
      "id": "dsi:facet/step", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Step", "facetKind": "dsi:facet-kind/identity", "bindingProperty": "dsi:hasStep",
      "definition": "Absolute position within a scale, as the product numbers it (12, 40, 600). A literal, not a concept; steps are only comparable within one scale of one product."
    },
    {
      "id": "dsi:facet/emphasis", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Emphasis", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/emphasis", "bindingProperty": "dsi:hasEmphasis",
      "definition": "Relative strength within a scale or intent (subtle, strong), as opposed to an absolute step."
    },
    {
      "id": "dsi:facet/intent", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Intent", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/intent", "bindingProperty": "dsi:hasIntent",
      "definition": "What the token communicates, independent of hue: status, brand emphasis or action consequence."
    },
    {
      "id": "dsi:facet/hue", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Hue", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/hue", "bindingProperty": "dsi:hasHue",
      "definition": "The named hue of a member of a categorical color set (tag, avatar, chart and user-chosen colors), where the hue itself is the meaning. Binds only together with usage/categorical (ADR 0017).",
      "scopeNote": "Not for status or brand colors: Danger is an intent, whatever its hue."
    },
    {
      "id": "dsi:facet/syntax", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Syntax", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/syntax", "bindingProperty": "dsi:hasSyntax",
      "definition": "The code or document syntax role a token colors (keyword, string, comment...). Values are the @lezer/highlight tags (ontology/schemes/syntax.jsonld)."
    },
    {
      "id": "dsi:facet/brightness", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Brightness", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/brightness", "bindingProperty": "dsi:hasBrightness",
      "definition": "Lightness relative to its family that holds in every theme (dimmest stays dimmest in light and dark), independent of emphasis.",
      "example": "Material surface-dim, surface-bright (m3.material.io/styles/color/roles: keep their relative brightness across both light and dark theme)"
    },
    {
      "id": "dsi:facet/property", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Property", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/property", "bindingProperty": "dsi:hasProperty",
      "definition": "Which visual property the token is meant to paint or size (background, text, border, ...).",
      "scopeNote": "Does not define a tier: Polaris color-bg-fill-critical binds property and intent and is Semantic."
    },
    {
      "id": "dsi:facet/usage", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Usage", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/usage", "bindingProperty": "dsi:hasUsage",
      "definition": "Where in the interface the token applies across components (page, surface, overlay, field, link, ...).",
      "editorialNote": "v1 values derived from Material, Carbon and Polaris semantic color tokens. Surface depth levels (Carbon layer-01..03, Material surface-container-low..highest) are expressed with emphasis or close matches, not separate usages."
    },
    {
      "id": "dsi:facet/component", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Component", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/component", "bindingProperty": "dsi:hasComponent",
      "definition": "The component a token is scoped to (button, text field, ...).",
      "editorialNote": "Values are added when a product ships component-scoped tokens (ADR 0014); whose part names become canonical stays a PLAN.md open question."
    },
    {
      "id": "dsi:facet/part", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Part", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/part", "bindingProperty": "dsi:hasPart",
      "definition": "An anatomical part of a component (container, label, icon, track, handle). Only meaningful together with a component."
    },
    {
      "id": "dsi:facet/style", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Style", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/style", "bindingProperty": "dsi:hasStyle",
      "definition": "The motion or type style a token belongs to: quick, utilitarian (productive) or larger, more noticeable (expressive). Comparable across systems that split their motion or type this way (ADR 0014)."
    },
    {
      "id": "dsi:facet/state", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "State", "facetKind": "dsi:facet-kind/identity", "valueScheme": "dsi:scheme/state", "bindingProperty": "dsi:hasState",
      "definition": "The interaction or selection state the token applies to."
    },
    {
      "id": "dsi:facet/mode", "type": "Concept", "inScheme": "dsi:scheme/facets", "topConceptOf": "dsi:scheme/facets",
      "prefLabel": "Mode", "facetKind": "dsi:facet-kind/context", "valueScheme": "dsi:scheme/mode", "bindingProperty": "dsi:inMode",
      "definition": "The theme context a value or alias edge holds in (light, dark, increased contrast).",
      "scopeNote": "Product themes map to canonical modes with typed matches: Carbon g10 and g100 are product themes, not modes."
    },

    { "id": "dsi:scheme/domain", "type": "ConceptScheme", "prefLabel": "Domain values" },
    { "id": "dsi:domain/color", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Color" },
    { "id": "dsi:domain/space", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Space", "nameForm": "spacing", "definition": "Gaps, padding and margins between elements." },
    { "id": "dsi:domain/size", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Size", "definition": "Dimensions of elements themselves (icon size, control height)." },
    { "id": "dsi:domain/shape", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Shape", "definition": "Corner radius and border width." },
    { "id": "dsi:domain/typography", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Typography", "nameForm": "type style" },
    { "id": "dsi:domain/elevation", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Elevation", "nameForm": "shadow", "definition": "Shadows and depth layering." },
    { "id": "dsi:domain/motion", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Motion", "definition": "Durations and easing." },
    { "id": "dsi:domain/layout", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Layout", "nameForm": "layout value", "definition": "Page-level layout values: breakpoints, z-index layers, container widths." },
    { "id": "dsi:domain/opacity", "type": "Concept", "inScheme": "dsi:scheme/domain", "topConceptOf": "dsi:scheme/domain", "prefLabel": "Opacity" },

    { "id": "dsi:scheme/brightness", "type": "ConceptScheme", "prefLabel": "Brightness values" },
    { "id": "dsi:brightness/dim", "type": "Concept", "inScheme": "dsi:scheme/brightness", "topConceptOf": "dsi:scheme/brightness", "prefLabel": "Dim", "definition": "The dimmest member of its family in every theme." },
    { "id": "dsi:brightness/bright", "type": "Concept", "inScheme": "dsi:scheme/brightness", "topConceptOf": "dsi:scheme/brightness", "prefLabel": "Bright", "definition": "The brightest member of its family in every theme." },

    { "id": "dsi:scheme/emphasis", "type": "ConceptScheme", "prefLabel": "Emphasis values", "editorialNote": "Seven steps since ADR 0018 (subtlest, subtler, subtle, default, strong, stronger, strongest). Steps are assigned by contrast rank against the page within a family, per mode; the native word maps exact only when its rank agrees, else close." },
    { "id": "dsi:emphasis/subtlest", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtlest", "notation": "1", "definition": "The weakest step of a family with more than three steps, e.g. Material surface-container-lowest." },
    { "id": "dsi:emphasis/subtler", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtler", "notation": "2", "definition": "Between subtlest and subtle (Atlassian subtler)." },
    { "id": "dsi:emphasis/subtle", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Subtle", "notation": "3" },
    { "id": "dsi:emphasis/default", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Default", "notation": "4", "definition": "Explicitly the middle emphasis, where the product names it (e.g. a 'base' or 'default' variant). Not implied by an unbound facet." },
    { "id": "dsi:emphasis/strong", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Strong", "notation": "5" },
    { "id": "dsi:emphasis/stronger", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Stronger", "notation": "6", "definition": "Between strong and strongest (Atlassian bolder)." },
    { "id": "dsi:emphasis/strongest", "type": "Concept", "inScheme": "dsi:scheme/emphasis", "topConceptOf": "dsi:scheme/emphasis", "prefLabel": "Strongest", "notation": "7", "definition": "The strongest step of a family with more than three steps, e.g. Material surface-container-highest." },

    { "id": "dsi:scheme/intent", "type": "ConceptScheme", "prefLabel": "Intent values", "scopeNote": "Native names (Critical, Error, Destructive) are not labels here. They belong in mappings with a match type, because they are rarely exact synonyms." },
    { "id": "dsi:intent/accent", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Accent", "definition": "Brand or primary emphasis that draws attention without signaling status." },
    { "id": "dsi:intent/neutral", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Neutral", "definition": "Deliberately carries no status or brand meaning." },
    { "id": "dsi:intent/info", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Info", "definition": "Status: informational, no action required.", "related": ["dsi:intent/discovery"] },
    { "id": "dsi:intent/discovery", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Discovery", "definition": "Marks something new or changed that invites exploration: new features, onboarding, promotion. Not a status and not a warning.", "example": "Atlassian color.background.discovery (\"change or something new\"); Primer upsell (close).", "related": ["dsi:intent/info", "dsi:intent/ai"] },
    { "id": "dsi:intent/success", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Success", "definition": "Status: completed or positive outcome." },
    { "id": "dsi:intent/warning", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Warning", "definition": "Status: needs attention; something may go wrong." },
    {
      "id": "dsi:intent/danger", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Danger",
      "definition": "Status: something is wrong, failed or at risk.",
      "related": ["dsi:intent/destructive"],
      "scopeNote": "Explorer Danger views also list Destructive tokens, marked as related, not equal."
    },
    {
      "id": "dsi:intent/caution", "type": "Concept", "inScheme": "dsi:scheme/intent", "prefLabel": "Caution",
      "broader": "dsi:intent/warning",
      "definition": "Status: a milder level of warning; worth noticing, unlikely to cause harm.",
      "example": "Polaris caution tokens (below its warning), Carbon support-caution-minor"
    },
    {
      "id": "dsi:intent/highlight", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Highlight",
      "definition": "Marks a region the user is focusing on, editing or has selected as text, without status or brand meaning.",
      "example": "Polaris emphasis tokens (editor focus areas), Carbon highlight (text selection)"
    },
    {
      "id": "dsi:intent/ai", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "AI",
      "definition": "Marks content or actions generated or assisted by AI.",
      "example": "Carbon ai-* tokens, Polaris magic tokens",
      "related": ["dsi:intent/discovery"]
    },
    {
      "id": "dsi:intent/destructive", "type": "Concept", "inScheme": "dsi:scheme/intent", "topConceptOf": "dsi:scheme/intent", "prefLabel": "Destructive",
      "definition": "Action consequence: the action deletes data or cannot be undone. Describes an action, not a status.",
      "related": ["dsi:intent/danger"]
    },

    { "id": "dsi:scheme/usage", "type": "ConceptScheme", "prefLabel": "Usage values" },
    { "id": "dsi:usage/page", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Page", "definition": "The outermost application background behind all surfaces.", "example": "Carbon background, Polaris color-bg, Material background" },
    { "id": "dsi:usage/surface", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Surface", "definition": "Containers placed on the page: cards, panels, layers.", "example": "Polaris color-bg-surface, Carbon layer-01, Material surface-container" },
    { "id": "dsi:usage/overlay", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Overlay", "definition": "Content floating above the page: menus, popovers, modals." },
    { "id": "dsi:usage/scrim", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Scrim", "definition": "The dimming layer behind a modal overlay.", "example": "Material scrim, Carbon overlay" },
    { "id": "dsi:usage/inverse", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Inverse", "definition": "Contrasting surfaces with the opposite lightness of the current theme (e.g. dark tooltip in light mode).", "example": "Material inverse-surface, Carbon background-inverse, Polaris color-bg-inverse", "scopeNote": "Only when the surface flips relative to the page between modes (Primer bgColor.inverse, Fluent BackgroundInverted, Carbon background-inverse), or content placed on such a surface (ADR 0018)." },
    { "id": "dsi:usage/field", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Field", "definition": "Form inputs: text fields, selects, text areas.", "example": "Carbon field-01, Polaris color-input-bg-surface" },
    { "id": "dsi:usage/link", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Link", "definition": "Inline navigational text links.", "example": "Carbon link-primary, Polaris color-text-link" },
    { "id": "dsi:usage/categorical", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Categorical", "definition": "A set of distinct colors assigned to identities or series (avatars by name hash, chart series), where each slot is a different color, not a level.", "example": "Polaris color-avatar-one..seven (assigned by hashing the user's name)" },
    { "id": "dsi:usage/data-viz", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Data visualization", "nameForm": "data-visualization", "definition": "Marks in charts and graphs: series colors, chart status colors. Combine with categorical (and hue) for series palettes; numbered slots without a hue name bind no hue.", "example": "Atlassian color.chart.*, Primer data.*" },
    { "id": "dsi:usage/code-surface", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Code surface", "nameForm": "code-surface", "definition": "Surfaces of code blocks and editors: background, gutter, line numbers, active and highlighted lines, diff lines. Syntax roles use syntax/*; diffs combine with syntax inserted, deleted or changed.", "example": "Atlassian color.background.code.*, Primer codeMirror.*, diffBlob.*", "scopeNote": "Not the deprecated usage/code (code display and syntax highlighting), which syntax/* replaced." },
    { "id": "dsi:usage/heading", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Heading", "definition": "Text that titles content." },
    { "id": "dsi:usage/display", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "prefLabel": "Display", "definition": "The largest, most expressive headings." },
    { "id": "dsi:usage/headline", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "prefLabel": "Headline", "definition": "High-emphasis headings for short, important text." },
    { "id": "dsi:usage/title", "type": "Concept", "inScheme": "dsi:scheme/usage", "broader": "dsi:usage/heading", "prefLabel": "Title", "definition": "Medium-emphasis headings for sections." },
    { "id": "dsi:usage/body", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Body", "definition": "Running text." },
    { "id": "dsi:usage/label", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Label", "definition": "Text inside components (buttons, chips, tabs)." },
    { "id": "dsi:usage/state-layer", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "State layer", "nameForm": "state-layer", "definition": "A translucent overlay showing interaction state (hover, pressed)." },
    { "id": "dsi:usage/navigation", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Navigation", "definition": "Application navigation chrome: side nav, top bar.", "example": "Polaris color-nav-bg" },
    { "id": "dsi:usage/skeleton", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Skeleton", "definition": "Loading placeholders.", "example": "Carbon skeleton-background" },
    { "id": "dsi:usage/code", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "Code", "definition": "Code display and syntax highlighting.", "deprecated": true, "editorialNote": "Deprecated 2026-10-31 after color-v1 round 1: too coarse for syntax-highlighting roles, which stay unmapped until a syntax-role vocabulary exists." },
    { "id": "dsi:usage/on-fill", "type": "Concept", "inScheme": "dsi:scheme/usage", "topConceptOf": "dsi:scheme/usage", "prefLabel": "On fill", "nameForm": "on-fill", "definition": "Content placed on a filled background of an intent or accent, where it must contrast with that fill. Combine with emphasis: subtle for content on a light container (Material on-error-container), unbound or strong for content on the solid fill (Material on-error).", "example": "Material on-error, Polaris color-text-critical-on-bg-fill, Carbon text-on-color", "scopeNote": "Decide by value and description, not by the native word: content that must contrast with a bold fill is on-fill even when a system calls it inverse (Atlassian color.text.inverse). Usage inverse is only for surfaces that flip between modes, or content on them (ADR 0018)." },

    { "id": "dsi:scheme/property", "type": "ConceptScheme", "prefLabel": "Property values" },
    { "id": "dsi:property/background", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Background", "definition": "Fill behind content: surfaces, containers, fills." },
    { "id": "dsi:property/foreground", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Foreground", "definition": "Text and icons together: one token colors both.", "example": "Material on-surface, Carbon text-on-color" },
    { "id": "dsi:property/text", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Text", "definition": "Text color only. A token that colors both text and icons binds foreground instead." },
    { "id": "dsi:property/icon", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Icon" },
    { "id": "dsi:property/border", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Border", "definition": "Borders, dividers and outlines that are part of layout." },
    { "id": "dsi:property/focus-ring", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Focus ring" },
    { "id": "dsi:property/shadow", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Shadow", "dsi:inDomain": { "id": "dsi:domain/elevation" } },

    { "id": "dsi:property/spacing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Spacing", "definition": "Gaps, padding and margins between and inside elements.", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/padding", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Padding", "definition": "Space inside a component between its edge and its content.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/gap", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Gap", "definition": "Space between a component's children.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/margin", "type": "Concept", "inScheme": "dsi:scheme/property", "prefLabel": "Margin", "definition": "Space outside a component or part, between it and its neighbours.", "broader": "dsi:property/spacing", "dsi:inDomain": { "id": "dsi:domain/space" } },
    { "id": "dsi:property/corner-radius", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Corner radius", "definition": "Rounding of corners.", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/corner-shape", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Corner shape", "definition": "A set of four corner radii, rounding only some corners (Material corner-large-top: 16px 16px 0 0).", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/border-width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Border width", "definition": "Thickness of borders and dividers.", "dsi:inDomain": { "id": "dsi:domain/shape" } },
    { "id": "dsi:property/height", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Height", "definition": "Fixed heights of elements (controls, rows).", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Width", "definition": "Fixed widths of elements.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Size", "definition": "Square dimensions used for both width and height.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/icon-size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Icon size", "definition": "Dimensions of icons.", "dsi:inDomain": { "id": "dsi:domain/size" } },
    { "id": "dsi:property/container-width", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Container width", "definition": "Maximum widths of layout containers.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/breakpoint", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Breakpoint", "definition": "Viewport widths at which layouts change.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/z-index", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Z-index", "definition": "Stacking order of layers.", "dsi:inDomain": { "id": "dsi:domain/layout" } },
    { "id": "dsi:property/elevation-level", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Elevation level", "definition": "Ordinal depth of a surface (level 0..5).", "dsi:inDomain": { "id": "dsi:domain/elevation" } },
    { "id": "dsi:property/opacity", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Opacity", "definition": "Transparency, such as state-layer overlays.", "dsi:inDomain": { "id": "dsi:domain/opacity" } },
    { "id": "dsi:property/font-family", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font family", "definition": "Typeface stack.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/font-weight", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font weight", "definition": "Weight of a typeface.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/font-size", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Font size", "definition": "Size of text.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/line-height", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Line height", "definition": "Height of a line of text.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/letter-spacing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Letter spacing", "definition": "Tracking between characters.", "dsi:inDomain": { "id": "dsi:domain/typography" } },
    { "id": "dsi:property/duration", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Duration", "definition": "Length of an animation.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/easing", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Easing", "definition": "Timing curve of an animation.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/spring-stiffness", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Spring stiffness", "definition": "Stiffness of a physics spring used instead of a duration and easing curve (M3 Expressive motion springs).", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/spring-damping", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Spring damping", "definition": "Damping ratio of a physics spring (1 = no overshoot).", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/transition", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Transition", "definition": "A composite of duration, delay and easing.", "dsi:inDomain": { "id": "dsi:domain/motion" } },
    { "id": "dsi:property/keyframes", "type": "Concept", "inScheme": "dsi:scheme/property", "topConceptOf": "dsi:scheme/property", "prefLabel": "Keyframes", "definition": "A named animation sequence.", "dsi:inDomain": { "id": "dsi:domain/motion" } },

    { "id": "dsi:scheme/hue", "type": "ConceptScheme", "prefLabel": "Hue values", "scopeNote": "A small canonical set for categorical colors. Native hue names outside it (coral, plum, pine, olive, lemon, auburn, cool-gray) map close to the nearest value by hue angle; neutrals map to gray." },
    { "id": "dsi:hue/red", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Red", "definition": "Hue around 0°." },
    { "id": "dsi:hue/orange", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Orange", "definition": "Hue around 30°." },
    { "id": "dsi:hue/yellow", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Yellow", "definition": "Hue around 55°." },
    { "id": "dsi:hue/lime", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Lime", "definition": "Hue around 80°." },
    { "id": "dsi:hue/green", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Green", "definition": "Hue around 120°." },
    { "id": "dsi:hue/teal", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Teal", "definition": "Hue around 170°." },
    { "id": "dsi:hue/cyan", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Cyan", "definition": "Hue around 190°." },
    { "id": "dsi:hue/blue", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Blue", "definition": "Hue around 215°." },
    { "id": "dsi:hue/indigo", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Indigo", "definition": "Hue around 240°." },
    { "id": "dsi:hue/purple", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Purple", "definition": "Hue around 270°." },
    { "id": "dsi:hue/magenta", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Magenta", "definition": "Hue around 300°." },
    { "id": "dsi:hue/pink", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Pink", "definition": "Hue around 330°." },
    { "id": "dsi:hue/brown", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Brown", "definition": "Low-saturation warm hue around 25°, darker than orange." },
    { "id": "dsi:hue/gray", "type": "Concept", "inScheme": "dsi:scheme/hue", "topConceptOf": "dsi:scheme/hue", "prefLabel": "Gray", "definition": "Neutral: no dominant hue (includes cool and warm grays)." },

    { "id": "dsi:scheme/style", "type": "ConceptScheme", "prefLabel": "Style values", "scopeNote": "Carbon names its two motion and type styles productive and expressive; Material names its easing sets standard and emphasized. Both splits mean quick and utilitarian versus noticeable, so native names map here with close." },
    { "id": "dsi:style/productive", "type": "Concept", "inScheme": "dsi:scheme/style", "topConceptOf": "dsi:scheme/style", "prefLabel": "Productive", "altLabel": "Standard", "definition": "Quick, subtle motion or compact type for everyday task work.", "editorialNote": "Source: https://carbondesignsystem.com/elements/motion/overview/" },
    { "id": "dsi:style/expressive", "type": "Concept", "inScheme": "dsi:scheme/style", "topConceptOf": "dsi:scheme/style", "prefLabel": "Expressive", "altLabel": "Emphasized", "definition": "Slower, more noticeable motion or display type for significant moments.", "editorialNote": "Source: https://m3.material.io/styles/motion/easing-and-duration" },

    { "id": "dsi:scheme/component", "type": "ConceptScheme", "prefLabel": "Component values", "scopeNote": "Only components that a product's shipped tokens name; not a component catalog." },
    { "id": "dsi:component/button", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Button" },
    { "id": "dsi:component/button-group", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Button group" },
    { "id": "dsi:component/card", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Card" },
    { "id": "dsi:component/text-field", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Text field", "definition": "A single-line text input with its label and supporting text (Material text field, Carbon TextInput, Polaris TextField)." },
    { "id": "dsi:component/table", "type": "Concept", "inScheme": "dsi:scheme/component", "topConceptOf": "dsi:scheme/component", "prefLabel": "Table" },

    { "id": "dsi:scheme/part", "type": "ConceptScheme", "prefLabel": "Part values", "scopeNote": "Anatomical parts named by shipped component tokens. A part binds only together with a component." },
    { "id": "dsi:part/container", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Container", "definition": "The component's outer box: background, shape, border, elevation, padding." },
    { "id": "dsi:part/label", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Label", "definition": "The component's main text (button label, field label)." },
    { "id": "dsi:part/supporting-text", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Supporting text", "definition": "Helper or description text under the main text." },
    { "id": "dsi:part/input", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Input", "definition": "The editable text area of a field." },
    { "id": "dsi:part/icon", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Icon", "definition": "An icon inside the component." },
    { "id": "dsi:part/indicator", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Indicator", "definition": "A line or mark that shows state (Material text field active indicator)." },
    { "id": "dsi:part/header", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Header", "definition": "A header region (card title area, table header row)." },
    { "id": "dsi:part/body", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Body", "definition": "The main content region." },
    { "id": "dsi:part/footer", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Footer", "definition": "A footer region with actions." },
    { "id": "dsi:part/row", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Row", "definition": "A table row." },
    { "id": "dsi:part/cell", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Cell" },
    { "id": "dsi:part/gutter", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Gutter", "definition": "The margin column of a code editor or diff, beside the lines." },
    { "id": "dsi:part/line-number", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Line number", "definition": "The number shown for a line of code." },
    { "id": "dsi:part/line", "type": "Concept", "inScheme": "dsi:scheme/part", "topConceptOf": "dsi:scheme/part", "prefLabel": "Line", "definition": "A whole line of code or diff, as opposed to a word within it." },

    { "id": "dsi:scheme/state", "type": "ConceptScheme", "prefLabel": "State values" },
    { "id": "dsi:state/hover", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Hover", "nameForm": "hovered" },
    { "id": "dsi:state/active", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Active", "nameForm": "pressed", "definition": "Being pressed. Material calls this pressed." },
    { "id": "dsi:state/focus", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Focus", "nameForm": "focused" },
    { "id": "dsi:state/disabled", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Disabled" },
    { "id": "dsi:state/selected", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Selected" },
    { "id": "dsi:state/dragged", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Dragged", "definition": "Being dragged. Material state layers have a dragged opacity (0.16)." },
    { "id": "dsi:state/visited", "type": "Concept", "inScheme": "dsi:scheme/state", "topConceptOf": "dsi:scheme/state", "prefLabel": "Visited", "definition": "A link the user has already followed." },

    { "id": "dsi:scheme/mode", "type": "ConceptScheme", "prefLabel": "Mode values" },
    { "id": "dsi:mode/light", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Light" },
    { "id": "dsi:mode/dark", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Dark" },
    { "id": "dsi:mode/expressive", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Expressive", "scopeNote": "A product's newer, more expressive token set shipped beside the one its components consume (Material Web tokens/versions/latest: M3 Expressive). Combines with light: color comes from light." },
    { "id": "dsi:mode/increased-contrast", "type": "Concept", "inScheme": "dsi:scheme/mode", "topConceptOf": "dsi:scheme/mode", "prefLabel": "Increased contrast", "scopeNote": "Combines with light or dark; a product's high-contrast-dark theme binds both." }
  ]
}
