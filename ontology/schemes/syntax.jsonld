  {
   "id": "dsi:scheme/syntax",
   "type": "ConceptScheme",
   "prefLabel": "Syntax roles",
   "definition": "Roles of code and document syntax for highlighting, adopted from the @lezer/highlight tag set (CodeMirror) with its own parent hierarchy.",
   "editorialNote": "Generated from @lezer/highlight 1.2.1 (dist/index.js tags table, parsed not executed). Carbon's syntax-* tokens are these tags in kebab case (carbon-design-system/carbon PRs #21047, #21230, #22037). Values carry the Lezer tag name as notation.",
   "rdfs:seeAlso": {
    "id": "https://lezer.codemirror.net/docs/ref/#highlight.tags"
   }
  },
  {
   "id": "dsi:syntax/comment",
   "type": "Concept",
   "inScheme": "dsi:scheme/syntax",
   "prefLabel": "Comment", "definition": "Text in source code that explains it and does not run.",
   "notation": "comment",
   "topConceptOf": "dsi:scheme/syntax"
  },
  {
   "id": "dsi:syntax/line-comment",
   "type": "Concept",
   "inScheme": "dsi:scheme/syntax",
