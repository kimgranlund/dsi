   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-13",
   "notation": "spacing.spacing-13",
   "definition": "Spacing token — 160px. Use for the largest page-level spacing needs."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-accessibility-background",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-accessibility-background",
   "notation": "--cds-status-accessibility-background",
   "definition": "Background color for accessibility status indicators. Use to highlight accessibility-related features or compliance status."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-blue",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-blue",
   "notation": "--cds-status-blue",
   "definition": "Color for blue status indicators. Use for informational states, in-progress items, or neutral status without specific semantic meaning."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-gray",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-gray",
   "notation": "--cds-status-gray",
   "definition": "Color for gray status indicators. Use for inactive, disabled, or neutral states that don't require color semantics."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-green",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-green",
   "notation": "--cds-status-green",
   "definition": "Color for green status indicators. Use for success states, completed items, active/running status, or positive conditions."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-orange",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-orange",
   "notation": "--cds-status-orange",
   "definition": "Color for orange status indicators. Use for warning states, items needing attention, or moderate priority issues."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-orange-outline",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-orange-outline",
   "notation": "--cds-status-orange-outline",
   "definition": "Outline/border color for orange status indicators in light themes. Provides visual definition for outlined warning status variants."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-purple",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-purple",
   "notation": "--cds-status-purple",
   "definition": "Color for purple status indicators. Use for special states, premium features, or custom priority levels."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-red",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-red",
   "notation": "--cds-status-red",
   "definition": "Color for red status indicators. Use for error states, failed items, critical issues, or stopped/inactive status."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-yellow",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "status-yellow",
   "notation": "--cds-status-yellow",
   "definition": "Color for yellow status indicators. Use for caution states, pending items, or situations requiring user awareness."
  },
  {
   "id": "dsi:native/carbon/11.84.0/status-yellow-outline",
   "type": "Concept",
