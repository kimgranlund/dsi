   "id": "dsi:native/carbon/11.84.0/spacing.spacing-01",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-01",
   "notation": "spacing.spacing-01",
   "definition": "Spacing token — 2px. Use for the smallest internal padding or gaps between tightly-packed elements."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-02",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-02",
   "notation": "spacing.spacing-02",
   "definition": "Spacing token — 4px. Use for compact padding within dense components."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-03",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-03",
   "notation": "spacing.spacing-03",
   "definition": "Spacing token — 8px. Default small spacing unit for inset padding and icon gaps."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-04",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-04",
   "notation": "spacing.spacing-04",
   "definition": "Spacing token — 12px. Use for comfortable inset padding in small components."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-05",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-05",
   "notation": "spacing.spacing-05",
   "definition": "Spacing token — 16px. Standard spacing unit; use for typical component padding and gutters."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-06",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-06",
   "notation": "spacing.spacing-06",
   "definition": "Spacing token — 24px. Use for section padding and medium gaps between components."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-07",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-07",
   "notation": "spacing.spacing-07",
   "definition": "Spacing token — 32px. Use for group separation and larger layout gaps."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-08",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-08",
   "notation": "spacing.spacing-08",
   "definition": "Spacing token — 40px. Use for generous padding between distinct sections."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-09",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-09",
   "notation": "spacing.spacing-09",
   "definition": "Spacing token — 48px. Use for large vertical rhythm and section separation."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-10",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-10",
   "notation": "spacing.spacing-10",
   "definition": "Spacing token — 64px. Use for major page section gaps."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-11",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-11",
   "notation": "spacing.spacing-11",
   "definition": "Spacing token — 80px. Use for hero and large feature-area spacing."
  },
  {
   "id": "dsi:native/carbon/11.84.0/spacing.spacing-12",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "spacing.spacing-12",
   "notation": "spacing.spacing-12",
   "definition": "Spacing token — 96px. Use for very large layout separations."
  },
  {
