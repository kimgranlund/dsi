   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-blue",
   "notation": "--cds-tag-background-blue",
   "definition": "Background color for blue tags. Use for informational tags or to categorize content with blue semantic meaning."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-cool-gray",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-cool-gray",
   "notation": "--cds-tag-background-cool-gray",
   "definition": "Background color for cool gray tags. Use for neutral categorization or when color semantics are not needed."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-cyan",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-cyan",
   "notation": "--cds-tag-background-cyan",
   "definition": "Background color for cyan tags. Use for tags related to data, analytics, or technical information."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-gray",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-gray",
   "notation": "--cds-tag-background-gray",
   "definition": "Background color for gray tags. Use for default or neutral tags without specific semantic meaning."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-green",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-green",
   "notation": "--cds-tag-background-green",
   "definition": "Background color for green tags. Use for success states, positive indicators, or approved/active status."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-magenta",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "tag-background-magenta",
   "notation": "--cds-tag-background-magenta",
   "definition": "Background color for magenta tags. Use for creative, design-related, or special category tags."
  },
  {
   "id": "dsi:native/carbon/11.84.0/tag-background-purple",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
