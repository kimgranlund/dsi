  {
   "id": "dsi:native/carbon/11.84.0/duration.fast.01",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.fast.01",
   "notation": "duration.fast.01",
   "definition": "Micro-interactions such as button and toggle. Instant response to user action."
  },
  {
   "id": "dsi:native/carbon/11.84.0/duration.fast.02",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.fast.02",
   "notation": "duration.fast.02",
   "definition": "Micro-interactions such as fade in. Subtle entrance or exit of small UI elements."
  },
  {
   "id": "dsi:native/carbon/11.84.0/duration.moderate.01",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.moderate.01",
   "notation": "duration.moderate.01",
   "definition": "Micro-interactions, small expansion, short distance movements. Default transition speed."
  },
  {
   "id": "dsi:native/carbon/11.84.0/duration.moderate.02",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.moderate.02",
   "notation": "duration.moderate.02",
   "definition": "Expansion, system communication, toast. Slightly longer interactions with more visual weight."
  },
  {
   "id": "dsi:native/carbon/11.84.0/duration.slow.01",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.slow.01",
   "notation": "duration.slow.01",
   "definition": "Large expansion, important system notifications. Deliberate, prominent transitions."
  },
  {
   "id": "dsi:native/carbon/11.84.0/duration.slow.02",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "duration.slow.02",
   "notation": "duration.slow.02",
   "definition": "Background dimming, large hero transitions. Slow, immersive motion for maximum emphasis."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.entrance.expressive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.entrance.expressive",
   "notation": "easing.entrance.expressive",
   "definition": "Entrance easing for expressive motion. Used for prominent element entrances."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.entrance.productive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.entrance.productive",
   "notation": "easing.entrance.productive",
   "definition": "Entrance easing for productive motion. Used when elements enter the screen."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.exit.expressive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.exit.expressive",
   "notation": "easing.exit.expressive",
   "definition": "Exit easing for expressive motion. Used for prominent element exits."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.exit.productive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.exit.productive",
   "notation": "easing.exit.productive",
   "definition": "Exit easing for productive motion. Used when elements leave the screen."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.standard.expressive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.standard.expressive",
   "notation": "easing.standard.expressive",
   "definition": "Standard easing for expressive motion. Used for elements with more prominent, fluid movement."
  },
  {
   "id": "dsi:native/carbon/11.84.0/easing.standard.productive",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/carbon/11.84.0",
   "prefLabel": "easing.standard.productive",
   "notation": "easing.standard.productive",
   "definition": "Standard easing for productive motion. Used for UI elements that move within the viewport."
  },
