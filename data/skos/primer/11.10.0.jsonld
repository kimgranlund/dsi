  {
   "id": "dsi:native/primer/11.10.0/base.text.lineHeight.loose",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.lineHeight.loose",
   "notation": "--base-text-lineHeight-loose",
   "definition": "Use sparingly for very small text or when maximum readability is critical. Best for footnotes, legal text, or content requiring high accessibility."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.lineHeight.normal",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.lineHeight.normal",
   "notation": "--base-text-lineHeight-normal",
   "definition": "Default choice for body text and general UI content. Provides optimal readability for paragraphs, descriptions, and most multi-line text. Use when unsure which line-height to pick."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.lineHeight.relaxed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.lineHeight.relaxed",
   "notation": "--base-text-lineHeight-relaxed",
   "definition": "Use for longer-form content, smaller text sizes (12-13px), or when increased readability is desired. Good for text that needs extra breathing room."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.lineHeight.snug",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.lineHeight.snug",
   "notation": "--base-text-lineHeight-snug",
   "definition": "Use for display text, large headings, or short multi-line text where moderate density is needed. Good for hero sections and marketing headlines."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.lineHeight.tight",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.lineHeight.tight",
   "notation": "--base-text-lineHeight-tight",
   "definition": "Use for single-line text in compact UI elements like labels, badges, buttons, or captions where vertical space is limited. Not recommended for multi-line body text due to reduced readability."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.size.2xl",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.size.2xl",
   "notation": "--base-text-size-2xl",
   "definition": "40px - Display text for hero sections."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.size.lg",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.size.lg",
   "notation": "--base-text-size-lg",
   "definition": "20px - Medium titles and subtitles."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.size.md",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.size.md",
   "notation": "--base-text-size-md",
   "definition": "16px - Large body text and small titles."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.size.sm",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/primer/11.10.0",
   "prefLabel": "base.text.size.sm",
   "notation": "--base-text-size-sm",
   "definition": "14px - Default body text size for UI."
  },
  {
   "id": "dsi:native/primer/11.10.0/base.text.size.xl",
