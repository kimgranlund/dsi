   "prefLabel": "color.background.neutral.subtle.default",
   "notation": "--ds-background-neutral-subtle",
   "definition": "Use for the background of elements that appear to have no background in a resting state, such as subtle buttons and menu items."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.neutral.subtle.hovered",
