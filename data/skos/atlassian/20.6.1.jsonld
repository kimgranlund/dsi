   "id": "dsi:native/atlassian/20.6.1/motion.duration.instant",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.instant",
   "notation": "--ds-duration-instant",
   "definition": "Use for instant feedback with no perceptible delay, such as list item hover, selected and focus states."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.long",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.long",
   "notation": "--ds-duration-long",
   "definition": "Use for medium entrance transitions, such as modal enter and flag enter."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.medium",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.medium",
   "notation": "--ds-duration-medium",
   "definition": "Use for medium exit transitions, such as modal exit and flag exit."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.short",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.short",
   "notation": "--ds-duration-short",
   "definition": "Use for interactive state emphasis and small entrances, such as button hover and pressed states, popup enter, and avatar appear."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.xlong",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.xlong",
   "notation": "--ds-duration-xlong",
   "definition": "Use for large transitions, such as panel enter/exit, page transitions, and full-screen overlays."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.xshort",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.xshort",
   "notation": "--ds-duration-xshort",
   "definition": "Use for subtle pressed states and quick exits, such as component press feedback, popup dismiss, and avatar transitions."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.xxlong",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.xxlong",
   "notation": "--ds-duration-xxlong",
   "definition": "Use for large transitions, such as onboarding steps and full-screen overlays."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.duration.xxshort",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.duration.xxshort",
   "notation": "--ds-duration-xxshort",
   "definition": "Use for instant feedback, such as list item hover, selected and focus states."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.in.practical",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.in.practical",
   "notation": "--ds-easing-in-practical",
   "definition": "Starts slowly and accelerates away. Best for exit transitions where elements leaving the screen should feel like they are getting out of the way."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.inout.bold",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.inout.bold",
   "notation": "--ds-easing-inout-bold",
   "definition": "The bold in-out curve pairs naturally with scale and repositioning of elements. It controls both the start and end of the motion."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.out.bold",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.out.bold",
   "notation": "--ds-easing-out-bold",
   "definition": "Elements arrive quickly and decelerate to a stop. The fast start grabs attention and the gentle landing feels controlled."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.out.practical",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.out.practical",
   "notation": "--ds-easing-out-practical",
   "definition": "A practical, everyday enter curve. Less dramatic than the bold variant, good for subtle transitions like content swaps, tab changes, and list reordering."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.spring",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.spring",
   "notation": "--ds-easing-spring",
   "definition": "A spring curve that overshoots slightly before settling. Use for playful, tactile feedback on small branded elements such as avatar hover, where the slight overshoot reinforces a sense of life."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.fillMode.AnimationFillModeBackwards",
