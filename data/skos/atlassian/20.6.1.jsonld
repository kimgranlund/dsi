  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.bold.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.bold.default",
   "notation": "--ds-background-selected-bold",
   "definition": "Use for the bold background of selected controls, such as checked checkboxes and selected radio buttons. Pair with color.text.inverse or color.icon.inverse for foreground content. Do not use for primary actions or keyboard focus alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.bold.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.bold.hovered",
   "notation": "--ds-background-selected-bold-hovered",
   "definition": "Use for the background of a selected control that uses color.background.selected.bold while it is hovered, such as a checked checkbox. Pair with color.text.inverse or color.icon.inverse for foreground content. Do not use for an unselected control or keyboard focus alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.bold.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.bold.pressed",
   "notation": "--ds-background-selected-bold-pressed",
   "definition": "Use for the background of a selected control that uses color.background.selected.bold while it is being pressed, such as a checked checkbox. Pair with color.text.inverse or color.icon.inverse for foreground content. Do not use for an unselected control or keyboard focus alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.default.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.default.default",
   "notation": "--ds-background-selected",
   "definition": "Use for the background of an element that communicates selection, such as a selected navigation item, or the opened state of a dropdown trigger. Use color.background.selected.hovered or color.background.selected.pressed when interacting with a selected element. Selection is distinct from keyboard focus and hover alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.default.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.default.hovered",
   "notation": "--ds-background-selected-hovered",
   "definition": "Use for the background of an element that is selected and hovered. This preserves selection while showing pointer hover; do not use for an unselected element or keyboard focus alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.selected.default.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.selected.default.pressed",
   "notation": "--ds-background-selected-pressed",
   "definition": "Use for the background of an element that is selected and being pressed. Return to color.background.selected or color.background.selected.hovered when the press ends and the element remains selected. Do not use for an unselected element or keyboard focus alone."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.success.bold.default",
