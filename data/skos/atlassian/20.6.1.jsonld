 "@graph": [
  {
   "id": "dsi:scheme/native/atlassian/20.6.1",
   "type": "ConceptScheme",
   "prefLabel": "Atlassian Design System 20.6.1 tokens",
   "definition": "Design tokens as shipped by Atlassian Design System 20.6.1, under their native names."
  },
  {
   "id": "dsi:scheme/vocab/atlassian",
   "type": "ConceptScheme",
   "prefLabel": "Atlassian Design System naming vocabulary",
   "definition": "Words Atlassian Design System builds its token names from, mapped to DesignSystemsIndex facet values."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/border.width.BorderWidth1",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
