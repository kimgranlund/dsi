   "notation": "border.width.BorderWidth1"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/border.width.BorderWidth2",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "border.width.BorderWidth2",
   "notation": "border.width.BorderWidth2"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/border.width.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "border.width.default",
   "notation": "--ds-border-width",
   "definition": "The default width for all standard component borders and dividers."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/border.width.focused",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "border.width.focused",
   "notation": "--ds-border-width-focused",
   "definition": "Use for the width of the focus ring on an interactive element that currently has keyboard or input focus. Pair with color.border.focused. When the element is also selected, keep the selection indicator and add the focus ring."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/border.width.selected",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "border.width.selected",
   "notation": "--ds-border-width-selected",
   "definition": "Use for the width of a border or visual indicator that communicates selection, such as an active tab or a chosen item. Pair with color.border.selected. Do not use as a substitute for a separate keyboard focus indicator."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.background.accent.blue.bolder.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.background.accent.blue.bolder.default",
   "notation": "--ds-background-accent-blue-bolder",
   "definition": "Use for blue backgrounds when there is no meaning tied to the color, and the background needs to pass min 3:1 contrast requirements."
  },
