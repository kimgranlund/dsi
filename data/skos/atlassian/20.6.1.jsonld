   "prefLabel": "color.text.code.tags",
   "notation": "--ds-text-code-tags",
   "definition": "Use for tags in syntax-highlighted code."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.danger",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.danger",
   "notation": "--ds-text-danger",
   "definition": "Use for critical text, such as input field error messaging."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.danger.bolder",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.danger.bolder",
   "notation": "--ds-text-danger-bolder",
   "definition": "Use for text on top of danger semantic labels to ensure accessibility and desired visual appearance."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.danger.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.danger.default",
   "notation": "--ds-text-danger",
   "definition": "Use for critical text, such as input field error messaging."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.default",
   "notation": "--ds-text",
   "definition": "Use for primary text, such as body copy, sentence case headers, and buttons."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.disabled",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.disabled",
   "notation": "--ds-text-disabled",
   "definition": "Use for text in a disabled state."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.discovery",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.discovery",
   "notation": "--ds-text-discovery",
   "definition": "Use for text to emphasize change or something new, such as in new lozenges."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.discovery.bolder",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.discovery.bolder",
   "notation": "--ds-text-discovery-bolder",
   "definition": "Use for text on top of discovery semantic labels to ensure accessibility and desired visual appearance."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.discovery.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.discovery.default",
   "notation": "--ds-text-discovery",
   "definition": "Use for text to emphasize change or something new, such as in new lozenges."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.information",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.information",
   "notation": "--ds-text-information",
   "definition": "Use for informative text or to communicate something is in progress, such as in-progress lozenges."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.information.bolder",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.information.bolder",
   "notation": "--ds-text-information-bolder",
   "definition": "Use for text on top of information semantic labels to ensure accessibility and desired visual appearance."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.information.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.information.default",
   "notation": "--ds-text-information",
   "definition": "Use for informative text or to communicate something is in progress, such as in-progress lozenges."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.inverse",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.inverse",
   "notation": "--ds-text-inverse",
   "definition": "Use for text on bold backgrounds."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.selected",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.selected",
   "notation": "--ds-text-selected",
   "definition": "Use for text that communicates selection, such as the active tab or a selected navigation item, or the opened state of a dropdown trigger. On bold selected backgrounds, use color.text.inverse instead. Do not use for unselected links, brand emphasis, or hover alone. Keep the selected text treatment when the element also has focus."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.subtle",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.subtle",
   "notation": "--ds-text-subtle",
   "definition": "Use for secondary text, such as navigation, subtle button links, input field labels, and all caps subheadings."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.subtlest",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.subtlest",
   "notation": "--ds-text-subtlest",
   "definition": "Use for tertiary text, such as meta-data, breadcrumbs, input field placeholder and helper text."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.success",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.success",
   "notation": "--ds-text-success",
   "definition": "Use for text to communicate a favorable outcome, such as input field success messaging."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.success.bolder",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.success.bolder",
   "notation": "--ds-text-success-bolder",
   "definition": "Use for text on top of success semantic labels to ensure accessibility and desired visual appearance."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.success.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.success.default",
   "notation": "--ds-text-success",
   "definition": "Use for text to communicate a favorable outcome, such as input field success messaging."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.warning.bolder",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.warning.bolder",
   "notation": "--ds-text-warning-bolder",
   "definition": "Use for text on top of warning semantic labels to ensure accessibility and desired visual appearance."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.warning.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.warning.default",
   "notation": "--ds-text-warning",
   "definition": "Use for text to emphasize caution, such as in moved lozenges."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.warning.inverse",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.warning.inverse",
   "notation": "--ds-text-warning-inverse",
   "definition": "Use for text when on bold warning backgrounds."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.rovo.surface.overlay.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.rovo.surface.overlay.default",
   "notation": "--ds-rovo-surface-overlay",
   "definition": "Use for Rovo overlay surface backgrounds."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.rovo.surface.overlay.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.rovo.surface.overlay.hovered",
   "notation": "--ds-rovo-surface-overlay-hovered",
   "definition": "Hovered state of elevation.rovo.surface.overlay."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.rovo.surface.overlay.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.rovo.surface.overlay.pressed",
   "notation": "--ds-rovo-surface-overlay-pressed",
   "definition": "Pressed state of elevation.rovo.surface.overlay."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.shadow.overflow.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.shadow.overflow.default",
   "notation": "--ds-shadow-overflow",
   "definition": "Use to create a shadow when content scrolls under other content."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.shadow.overflow.perimeter",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.shadow.overflow.perimeter",
   "notation": "--ds-shadow-overflow-perimeter",
   "definition": "Use only when elevation.shadow.overflow is not technically feasible to implement. Pair with elevation.shadow.overflow.spread to replicate the overflow shadow."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.shadow.overflow.spread",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.shadow.overflow.spread",
   "notation": "--ds-shadow-overflow-spread",
   "definition": "Use only when elevation.shadow.overflow is not technically feasible to implement. Pair with elevation.shadow.overflow.perimeter to replicate the overflow shadow."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.shadow.overlay",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.shadow.overlay",
   "notation": "--ds-shadow-overlay",
   "definition": "Use for the box shadow of elements that sit on top of the UI, such as modals, dropdown menus, flags, and inline dialogs. Combine with elevation.surface.overlay\n\nAlso use for the box shadow of raised cards in a dragged state."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.shadow.raised",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.shadow.raised",
   "notation": "--ds-shadow-raised",
   "definition": "Use for the box shadow of raised card elements, such as Jira cards on a Kanban board. Combine with elevation.surface.raised"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.container.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.container.default",
   "notation": "--ds-surface-container",
   "definition": "Use as a neutral container surface background."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.container.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.container.hovered",
   "notation": "--ds-surface-container-hovered",
   "definition": "Hovered state of elevation.surface.container"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.container.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.container.pressed",
   "notation": "--ds-surface-container-pressed",
   "definition": "Pressed state of elevation.surface.container"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.default.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.default.default",
   "notation": "--ds-surface",
   "definition": "Use as the primary background for the UI."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.default.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.default.hovered",
   "notation": "--ds-surface-hovered",
   "definition": "Hovered state of elevation.surface"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.default.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.default.pressed",
   "notation": "--ds-surface-pressed",
   "definition": "Pressed state of elevation.surface"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.overlay.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.overlay.default",
   "notation": "--ds-surface-overlay",
   "definition": "Use for the background of elements that sit on top of they UI, such as modals, dialogs, dropdown menus, floating toolbars, and floating single-action buttons. Also use for the background of raised cards in a dragged state. Combine with elevation.shadow.overlay."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.overlay.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.overlay.hovered",
   "notation": "--ds-surface-overlay-hovered",
   "definition": "Hovered state of elevation.surface.overlay"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.overlay.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.overlay.pressed",
   "notation": "--ds-surface-overlay-pressed",
   "definition": "Pressed state of elevation.surface.overlay"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.raised.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.raised.default",
   "notation": "--ds-surface-raised",
   "definition": "Use for the background of cards that can be moved, such as Jira cards on a Kanban board. Combine with elevation.shadow.raised."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.raised.hovered",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.raised.hovered",
   "notation": "--ds-surface-raised-hovered",
   "definition": "Hovered state of elevation.surface.raised"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.raised.pressed",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.raised.pressed",
   "notation": "--ds-surface-raised-pressed",
   "definition": "Pressed state of elevation.surface.raised"
  },
  {
   "id": "dsi:native/atlassian/20.6.1/elevation.surface.sunken",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "elevation.surface.sunken",
   "notation": "--ds-surface-sunken",
   "definition": "A secondary background for the UI commonly used for grouping items, such as Jira cards in columns."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.body.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.body.default",
   "notation": "--ds-font-body",
   "definition": "Use in short descriptions or labels. The default size for text in components. Migrate instances of Paragraph Default and UI Text to Body M."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.body.large",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.body.large",
   "notation": "--ds-font-body-large",
   "definition": "For long-form text, such as in blogs."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.body.small",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.body.small",
   "notation": "--ds-font-body-small",
   "definition": "Use in secondary level content such as fine print or semantic messaging. Use sparingly. Migrate instances of Small text to Body S."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.code.default",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.code.default",
   "notation": "--ds-font-code",
   "definition": "For representing code only, either inline or in code blocks."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.family.body",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.family.body",
   "notation": "--ds-font-family-body",
   "definition": "For our default UI body text."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.family.brand.body",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.family.brand.body",
   "notation": "--ds-font-family-brand-body",
   "definition": "For our brand body text. Uses Charlie Text."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.family.brand.heading",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.family.brand.heading",
   "notation": "--ds-font-family-brand-heading",
   "definition": "For our brand heading text. Uses Charlie Display."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.family.code",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.family.code",
   "notation": "--ds-font-family-code",
   "definition": "For representing code only."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.family.heading",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.family.heading",
   "notation": "--ds-font-family-heading",
   "definition": "For our default UI heading text."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.large",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.large",
   "notation": "--ds-font-heading-large",
   "definition": "App page titles, such as forms. Migrate instances of H700 to Heading L."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.medium",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.medium",
   "notation": "--ds-font-heading-medium",
   "definition": "Headers in large components, such as modal dialogs. Migrate instances of H600 to Heading M."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.small",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.small",
   "notation": "--ds-font-heading-small",
   "definition": "For headers in small components where space is limited. Migrate instances of H500 to Heading S."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.xlarge",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.xlarge",
   "notation": "--ds-font-heading-xlarge",
   "definition": "For overlapping brand with app promotions, such as marketplace content. Migrate instances of H800 to Heading XL."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.xsmall",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.xsmall",
   "notation": "--ds-font-heading-xsmall",
   "definition": "For headers in small components where space is limited. Migrate instances of H400 to Heading XS."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.xxlarge",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.xxlarge",
   "notation": "--ds-font-heading-xxlarge",
   "definition": "For overlapping brand with app promotions, such as marketplace content. Migrate instances of H900 to Heading XXL."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.heading.xxsmall",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "font.heading.xxsmall",
   "notation": "--ds-font-heading-xxsmall",
   "definition": "For headers in fine print or tight spaces. Use sparingly. Migrate instances of H100, H200 and H300 to Heading XXS."
  },
  {
   "id": "dsi:native/atlassian/20.6.1/font.metric.large",
