  },
  {
   "id": "dsi:native/atlassian/20.6.1/color.text.code.numbers",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "color.text.code.numbers",
   "notation": "--ds-text-code-numbers",
   "definition": "Use for numeric values in syntax-highlighted code."
