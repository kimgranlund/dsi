   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.inout.bold",
   "notation": "--ds-easing-inout-bold",
   "definition": "The bold in-out curve pairs naturally with scale and repositioning of elements. It controls both the start and end of the motion.",
   "skos:broadMatch": [
    {
     "id": "dsi:concept/motion/property-easing"
    }
   ]
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.out.bold",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.out.bold",
   "notation": "--ds-easing-out-bold",
   "definition": "Elements arrive quickly and decelerate to a stop. The fast start grabs attention and the gentle landing feels controlled.",
   "skos:broadMatch": [
    {
     "id": "dsi:concept/motion/property-easing"
    }
   ]
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.out.practical",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.out.practical",
   "notation": "--ds-easing-out-practical",
   "definition": "A practical, everyday enter curve. Less dramatic than the bold variant, good for subtle transitions like content swaps, tab changes, and list reordering.",
   "skos:broadMatch": [
    {
     "id": "dsi:concept/motion/property-easing"
    }
   ]
  },
  {
   "id": "dsi:native/atlassian/20.6.1/motion.easing.spring",
   "type": "Concept",
   "inScheme": "dsi:scheme/native/atlassian/20.6.1",
   "prefLabel": "motion.easing.spring",
   "notation": "--ds-easing-spring",
   "definition": "A spring curve that overshoots slightly before settling. Use for playful, tactile feedback on small branded elements such as avatar hover, where the slight overshoot reinforces a sense of life."
  },
