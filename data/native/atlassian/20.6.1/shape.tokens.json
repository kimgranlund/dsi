{
  "border": {
    "width": {
      "default": {
        "$description": "The default width for all standard component borders and dividers.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/esm/artifacts/tokens-raw/atlassian-shape.js",
            "implementation": "atlaskit-tokens",
            "nativeName": "--ds-border-width",
            "package": "@atlaskit/tokens",
            "product": "atlassian",
            "rawValue": "1px",
            "version": "20.6.1"
          }
        },
        "$value": "{border.width.BorderWidth1}"
      },
      "focused": {
        "$description": "Use for the width of the focus ring on an interactive element that currently has keyboard or input focus. Pair with color.border.focused. When the element is also selected, keep the selection indicator and add the focus ring.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/esm/artifacts/tokens-raw/atlassian-shape.js",
            "implementation": "atlaskit-tokens",
            "nativeName": "--ds-border-width-focused",
            "package": "@atlaskit/tokens",
            "product": "atlassian",
            "rawValue": "2px",
            "version": "20.6.1"
          }
        },
        "$value": "{border.width.BorderWidth2}"
      },
      "selected": {
        "$description": "Use for the width of a border or visual indicator that communicates selection, such as an active tab or a chosen item. Pair with color.border.selected. Do not use as a substitute for a separate keyboard focus indicator.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/esm/artifacts/tokens-raw/atlassian-shape.js",
            "implementation": "atlaskit-tokens",
            "nativeName": "--ds-border-width-selected",
            "package": "@atlaskit/tokens",
            "product": "atlassian",
            "rawValue": "2px",
            "version": "20.6.1"
          }
        },
        "$value": "{border.width.BorderWidth2}"
      }
    }
  },
