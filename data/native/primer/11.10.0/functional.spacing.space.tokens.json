      "$description": "Spacious spacing for major layout divisions and visual separation between content blocks.",
      "$extensions": {
        "io.nonoun.dsi": {
          "file": "dist/docs/functional/spacing/space.json",
          "implementation": "primer-primitives",
          "nativeName": "--space-lg",
          "package": "@primer/primitives",
          "product": "primer",
          "rawValue": "1rem",
          "version": "11.10.0"
        },
        "org.primer.figma": {
          "collection": "functional/size",
          "scopes": [
            "gap"
          ]
        },
        "org.primer.llm": {
          "rules": "Spacious (16px). Use for major layout divisions, visual separation between content blocks, and primary container margins.",
          "usage": [
            "gap",
            "padding",
            "margin",
            "section-gap",
            "container-margin"
          ]
        }
      },
      "$value": "{base.size.16}"
    },
