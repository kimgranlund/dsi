    "easing": {
      "ease": {
        "$description": "CSS default easing. Use for hover state changes and micro-interactions.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/docs/base/motion/motion.json",
            "implementation": "primer-primitives",
            "nativeName": "--base-easing-ease",
            "package": "@primer/primitives",
            "product": "primer",
            "rawValue": "[0.25,0.1,0.25,1]",
            "version": "11.10.0"
          },
          "org.primer.llm": {
            "rules": "Use for hover state changes.",
            "usage": [
              "hover-state",
              "micro-interaction",
              "button-hover",
              "link-hover"
            ]
          }
        },
        "$type": "cubicBezier",
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ]
      },
      "easeIn": {
        "$description": "Accelerating motion. Use for elements exiting the viewport (moving off-screen).",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/docs/base/motion/motion.json",
            "implementation": "primer-primitives",
            "nativeName": "--base-easing-easeIn",
            "package": "@primer/primitives",
            "product": "primer",
            "rawValue": "[0.7,0.1,0.75,0.9]",
            "version": "11.10.0"
          },
          "org.primer.llm": {
            "rules": "Rarely used alone. Prefer ease-out for most exit animations.",
            "usage": [
              "exit-animation",
              "element-leaving",
              "off-screen-motion"
            ]
          }
        },
        "$type": "cubicBezier",
        "$value": [
          0.7,
          0.1,
          0.75,
          0.9
        ]
      },
      "easeInOut": {
        "$description": "Smooth acceleration and deceleration. Use for elements moving or morphing within the viewport.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/docs/base/motion/motion.json",
            "implementation": "primer-primitives",
            "nativeName": "--base-easing-easeInOut",
            "package": "@primer/primitives",
            "product": "primer",
            "rawValue": "[0.6,0,0.2,1]",
            "version": "11.10.0"
          },
          "org.primer.llm": {
            "rules": "Use if an element moves or morphs on screen.",
            "usage": [
              "position-change",
              "size-change",
              "morph-animation",
              "expand-collapse",
              "slide-transition"
            ]
          }
        },
        "$type": "cubicBezier",
        "$value": [
          0.6,
          0,
          0.2,
          1
        ]
      },
      "easeOut": {
        "$description": "Decelerating motion. Use for elements entering the viewport or appearing on screen.",
        "$extensions": {
          "io.nonoun.dsi": {
            "file": "dist/docs/base/motion/motion.json",
            "implementation": "primer-primitives",
            "nativeName": "--base-easing-easeOut",
            "package": "@primer/primitives",
            "product": "primer",
            "rawValue": "[0.3,0.8,0.6,1]",
            "version": "11.10.0"
          },
          "org.primer.llm": {
            "rules": "RECOMMENDED default. Use if an element enters or exits the viewport.",
            "usage": [
              "enter-animation",
              "element-appearing",
              "modal-open",
              "dropdown-open",
              "tooltip-appear"
            ]
          }
        },
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0.8,
          0.6,
          1
        ]
      },
      "linear": {
