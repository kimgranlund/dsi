              "transform": "scale(1)"
            },
            "enterEasing": {
              "mode": "productive",
              "name": "standard"
            },
            "exit": {
              "opacity": 0,
              "transform": "scale(0.96)"
            },
            "exitEasing": {
              "mode": "productive",
              "name": "standard"
            },
            "kind": "shared-element"
          }
        },
        "io.nonoun.dsi": {
          "file": "tokens/surfaces.tokens.json",
          "implementation": "carbon-elements",
          "nativeName": "surface.expand",
          "package": "@carbon/motion",
