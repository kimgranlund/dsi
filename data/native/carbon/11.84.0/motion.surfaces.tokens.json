        "com.ibm.carbon": {
          "motion": {
            "duration": "moderate-02",
            "enterEasing": {
              "mode": "expressive",
              "name": "standard"
            },
            "exitEasing": {
              "mode": "expressive",
              "name": "standard"
            },
            "kind": "shared-element",
            "origin": "trigger"
          }
        },
        "io.nonoun.dsi": {
          "file": "tokens/surfaces.tokens.json",
          "implementation": "carbon-elements",
          "nativeName": "surface.invoke",
          "package": "@carbon/motion",
